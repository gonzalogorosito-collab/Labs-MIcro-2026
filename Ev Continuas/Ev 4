; ============================================================
; Mapeo de pines (grupo ANODO = activo en ALTO, con resistencia
;                  grupo CATODO = activo en BAJO, sin resistencia)
;
;   ANODO  (filas del codigo):
;     PD4-PD7 = D4-D7   -> anodo 0-3
;     PB0-PB3 = D8-D11  -> anodo 4-7
;   CATODO (columnas del codigo):
;     PB4,PB5 = D12,D13 -> catodo 0-1
;     PC0-PC5 = A0-A5   -> catodo 2-7
;
;   Botones: INT0=PD2 (par siguiente), INT1=PD3 (par anterior), a GND
; ============================================================

.include "m328Pdef.inc"

.def temp    = r16
.def temp2   = r17
.def rowbits = r18
.def row     = r19
.def pair    = r20
.def frame   = r21
.def flags   = r22
.def cntlo   = r23
.def cnthi   = r24
.def temp3   = r25

.equ BLINKTH_LO = low(480)
.equ BLINKTH_HI = high(480)

; ---------------- Vectores de interrupcion ----------------
.cseg
.org 0x0000
    rjmp RESET
.org 0x0002
    rjmp INT0_ISR
.org 0x0004
    rjmp INT1_ISR
.org 0x0020
    rjmp TIM0_ISR

; ================= INICIALIZACION =================
.org 0x0034
RESET:
    ldi temp, low(RAMEND)
    out SPL, temp
    ldi temp, high(RAMEND)
    out SPH, temp

    ldi temp, 0xF0
    out DDRD, temp
    ldi temp, 0x3F
    out DDRB, temp
    ldi temp, 0x3F
    out DDRC, temp

    ldi temp, 0x0C
    out PORTD, temp
    clr temp
    out PORTB, temp
    out PORTC, temp

    clr row
    clr pair
    clr frame
    clr flags
    clr cntlo
    clr cnthi

    ldi temp, (1<<ISC01)|(1<<ISC11)
    sts EICRA, temp
    ldi temp, (1<<INT0)|(1<<INT1)
    out EIMSK, temp

    clr temp
    out TCCR0A, temp
    ldi temp, (1<<CS01)|(1<<CS00)
    out TCCR0B, temp
    ldi temp, (1<<TOIE0)
    sts TIMSK0, temp

    sei

; ================= LOOP PRINCIPAL =================
; El main no hace nada mas que sondear las flags que levantan las ISR
; de los botones (bit0=INT0, bit1=INT1) y, cuando el boton se solto,
; llama a la rutina que avanza/retrocede de par y reactiva la interrupcion.
MAIN:
    sbrc flags, 0
    rjmp CHECK_BTN0
    rjmp CHK1
CHECK_BTN0:
    sbic PIND, 2          ; espera a que se suelte el boton (antirrebote)
    rcall REENABLE0
CHK1:
    sbrc flags, 1
    rjmp CHECK_BTN1
    rjmp MAIN
CHECK_BTN1:
    sbic PIND, 3          ; espera a que se suelte el boton (antirrebote)
    rcall REENABLE1
    rjmp MAIN

; --- avanza al siguiente par y reactiva INT0 ---
REENABLE0:
    cli
    inc pair
    cpi pair, 3
    brne RE0_OK
    clr pair               ; vuelve a 0 despues del ultimo par
RE0_OK:
    clr frame               ; reinicia en la 1ra imagen del par nuevo
    clr cntlo
    clr cnthi                ; reinicia el contador de parpadeo
    cbr flags, (1<<0)
    sei
    sbi EIFR, INTF0          ; limpia flag de interrupcion pendiente
    sbi EIMSK, INT0          ; reactiva INT0
    ret

; --- retrocede al par anterior y reactiva INT1 ---
REENABLE1:
    cli
    tst pair
    brne RE1_DEC
    ldi pair, 2              ; si estaba en 0, da la vuelta al ultimo par
    rjmp RE1_OK
RE1_DEC:
    dec pair
RE1_OK:
    clr frame
    clr cntlo
    clr cnthi
    cbr flags, (1<<1)
    sei
    sbi EIFR, INTF1
    sbi EIMSK, INT1
    ret

; ================= INTERRUPCIONES EXTERNAS =================
; Solo enmascaran su propia interrupcion y levantan la flag;
; el trabajo real (avanzar/retroceder) lo hace el main loop
; una vez que confirma que el boton ya se solto (antirrebote).
INT0_ISR:
    cbi EIMSK, INT0
    sbr flags, (1<<0)
    reti

INT1_ISR:
    cbi EIMSK, INT1
    sbr flags, (1<<1)
    reti

; --- stub temporal: se completa en el proximo commit ---
TIM0_ISR:
    reti
