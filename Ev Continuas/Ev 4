; ============================================================
; Mapeo de pines (grupo ANODO = activo en ALTO, con resistencia
;                  grupo CATODO = activo en BAJO, sin resistencia)
;
;   ANODO  (filas del codigo):
;     PD4-PD7 = D4-D7   -> anodo 0-3
;     PB0-PB3 = D8-D11  -> anodo 4-7
;   CATODO (columnas del codigo):
;     PB4,PB5 = D12,D13 -> catodo 0-1
;     PC0-PC5 = A0-A5   -> catodo 2-7
;
;   Botones: INT0=PD2 (par siguiente), INT1=PD3 (par anterior), a GND
; ============================================================

.include "m328Pdef.inc"

.def temp    = r16
.def temp2   = r17
.def rowbits = r18
.def row     = r19
.def pair    = r20
.def frame   = r21
.def flags   = r22
.def cntlo   = r23
.def cnthi   = r24
.def temp3   = r25

.equ BLINKTH_LO = low(480)
.equ BLINKTH_HI = high(480)

; ---------------- Vectores de interrupcion ----------------
.cseg
.org 0x0000
    rjmp RESET
.org 0x0002
    rjmp INT0_ISR
.org 0x0004
    rjmp INT1_ISR
.org 0x0020
    rjmp TIM0_ISR

; ================= INICIALIZACION =================
.org 0x0034
RESET:
    ldi temp, low(RAMEND)
    out SPL, temp
    ldi temp, high(RAMEND)
    out SPH, temp

    ldi temp, 0xF0
    out DDRD, temp
    ldi temp, 0x3F
    out DDRB, temp
    ldi temp, 0x3F
    out DDRC, temp

    ldi temp, 0x0C
    out PORTD, temp
    clr temp
    out PORTB, temp
    out PORTC, temp

    clr row
    clr pair
    clr frame
    clr flags
    clr cntlo
    clr cnthi

    ldi temp, (1<<ISC01)|(1<<ISC11)
    sts EICRA, temp
    ldi temp, (1<<INT0)|(1<<INT1)
    out EIMSK, temp

    clr temp
    out TCCR0A, temp
    ldi temp, (1<<CS01)|(1<<CS00)
    out TCCR0B, temp
    ldi temp, (1<<TOIE0)
    sts TIMSK0, temp

    sei

; ================= LOOP PRINCIPAL =================
MAIN:
    sbrc flags, 0
    rjmp CHECK_BTN0
    rjmp CHK1
CHECK_BTN0:
    sbic PIND, 2
    rcall REENABLE0
CHK1:
    sbrc flags, 1
    rjmp CHECK_BTN1
    rjmp MAIN
CHECK_BTN1:
    sbic PIND, 3
    rcall REENABLE1
    rjmp MAIN

REENABLE0:
    cli
    inc pair
    cpi pair, 3
    brne RE0_OK
    clr pair
RE0_OK:
    clr frame
    clr cntlo
    clr cnthi
    cbr flags, (1<<0)
    sei
    sbi EIFR, INTF0
    sbi EIMSK, INT0
    ret

REENABLE1:
    cli
    tst pair
    brne RE1_DEC
    ldi pair, 2
    rjmp RE1_OK
RE1_DEC:
    dec pair
RE1_OK:
    clr frame
    clr cntlo
    clr cnthi
    cbr flags, (1<<1)
    sei
    sbi EIFR, INTF1
    sbi EIMSK, INT1
    ret

; ================= INTERRUPCIONES EXTERNAS =================
INT0_ISR:
    cbi EIMSK, INT0
    sbr flags, (1<<0)
    reti

INT1_ISR:
    cbi EIMSK, INT1
    sbr flags, (1<<1)
    reti

; ================= REFRESCO POR MULTIPLEXADO (Timer0) =================
; Se ejecuta cada overflow de Timer0 (~1ms). En cada llamada:
TIM0_ISR:
    in temp3, SREG
    push temp
    push temp2
    push rowbits
    push r30
    push r31

    ; --- (1) anodo en bajo por defecto (inactivo) ---
    in temp, PORTD
    andi temp, 0x0F
    out PORTD, temp
    in temp, PORTB
    andi temp, 0xF0
    out PORTB, temp

    ; --- (2) leer bitmap de la fila actual desde flash ---
    ; direccion = BITMAPS + pair*16 + frame*8 + row
    ldi r30, low(BITMAPS*2)
    ldi r31, high(BITMAPS*2)
    mov temp, pair
    lsl temp
    lsl temp
    lsl temp
    lsl temp                ; pair*16
    add r30, temp
    clr temp
    adc r31, temp
    mov temp, frame
    lsl temp
    lsl temp
    lsl temp                ; frame*8
    add r30, temp
    clr temp
    adc r31, temp
    add r30, row
    clr temp
    adc r31, temp
    lpm rowbits, Z

    ; --- (3) bit=1 (encendido) -> catodo en bajo ---
    com rowbits

    ; --- (4) escribir columnas ---
    mov temp, rowbits
    lsr temp
    lsr temp
    andi temp, 0x3F
    out PORTC, temp          ; catodo 2-7

    mov temp, rowbits
    andi temp, 0x03
    swap temp
    in temp2, PORTB
    andi temp2, 0x0F
    or temp2, temp
    out PORTB, temp2         ; catodo 0-1

    ; --- (5) anodo activo en alto (fila seleccionada) ---
    ldi r30, low(ROWMASK_D_OR*2)
    ldi r31, high(ROWMASK_D_OR*2)
    add r30, row
    clr temp
    adc r31, temp
    lpm temp, Z
    in temp2, PORTD
    or temp2, temp
    out PORTD, temp2

    ldi r30, low(ROWMASK_B_OR*2)
    ldi r31, high(ROWMASK_B_OR*2)
    add r30, row
    clr temp
    adc r31, temp
    lpm temp, Z
    in temp2, PORTB
    or temp2, temp
    out PORTB, temp2

    ; --- (6) siguiente fila (0..7, circular) ---
    inc row
    cpi row, 8
    brne TIM0_CONT
    clr row
TIM0_CONT:

    ; --- (7) contador de overflows para alternar frame (~500ms) ---
    inc cntlo
    brne TIM0_NOCARRY
    inc cnthi
TIM0_NOCARRY:
    ldi temp, BLINKTH_LO
    cp cntlo, temp
    ldi temp, BLINKTH_HI
    cpc cnthi, temp
    brlo TIM0_END
    clr cntlo
    clr cnthi
    ldi temp, 1
    eor frame, temp          ; alterna 0<->1 (efecto guiño/parpadeo)
TIM0_END:
    pop r31
    pop r30
    pop rowbits
    pop temp2
    pop temp
    out SREG, temp3
    reti

; ================= TABLAS DE FIGURAS =================
BITMAPS:
.db 0x3C,0x42,0xA5,0x81,0xC3,0x3C,0x42,0x3C   ; sonriendo (boca curvada)
.db 0x3C,0x42,0xAD,0x81,0xC3,0x3C,0x42,0x3C   ; guiñando (misma boca)
.db 0x66,0xFF,0xFF,0xFF,0x7E,0x3C,0x18,0x00   ; corazon
.db 0x00,0x42,0x00,0x00,0x00,0x5A,0x24,0x00   ; :3
.db 0x99,0x5A,0x3C,0xFF,0xFF,0x3C,0x5A,0x99   ; asterisco
.db 0x42,0x24,0x18,0x18,0x24,0x7E,0xFF,0x3C   ; XD (X a medida + D original)

; --- mascaras OR para activar (en alto) el anodo de la fila "row" ---
ROWMASK_D_OR:
.db 0x10,0x20,0x40,0x80,0x00,0x00,0x00,0x00   ; filas 0-3 (PD4-PD7)
ROWMASK_B_OR:
.db 0x00,0x00,0x00,0x00,0x01,0x02,0x04,0x08   ; filas 4-7 (PB0-PB3)
