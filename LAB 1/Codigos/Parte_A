.include "m328pdef.inc"

; --- DEFINICIÓN DE REGISTROS ---
.def TEMP    = r16    ; Registro temporal de trabajo
.def STATE   = r17    ; Estado de la FSM (0:Listo, 1:Lavado, 2:Centrifugado, 3:Secado, 4:Fin)
.def LOAD    = r18    ; Tipo de Carga (0: Ligera, 1: Media, 2: Pesada)
.def COUNTER = r19    ; Contador auxiliar para ciclos de retardo
.def SECONDS = r23    ; Registro para la duración dinámica de retardos

; --- DEFINICIÓN DE PINES (PORTD - Entradas) ---
.equ P_INICIO = PD2   ; Pulsador de Inicio (Arduino Pin 2)
.equ P_CARGA  = PD3   ; Pulsador de Selección de Carga (Arduino Pin 3)
.equ S_PUERTA = PD4   ; Sensor de Puerta Cerrada (Arduino Pin 4, 1 = Cerrada)
.equ S_AGUA   = PD5   ; Sensor de Nivel de Agua (Arduino Pin 5, 1 = Lleno)

; --- VECTOR DE RESET ---
.cseg
.org 0x0000
    rjmp RESET

RESET:
    ; 1. Inicialización de la Pila (Stack Pointer)
    ldi TEMP, HIGH(RAMEND)
    out SPH, TEMP
    ldi TEMP, LOW(RAMEND)
    out SPL, TEMP

    ; 2. Configuración de Direcciones I/O (DDR)
    clr TEMP
    out DDRD, TEMP        ; PORTD completo como ENTRADAS (PD2..PD5)
    
    ldi TEMP, 0x1F        ; PB0..PB4 como SALIDAS (LEDs de Estado: Pines 8-12)
    out DDRB, TEMP
    
    ldi TEMP, 0x07        ; PC0..PC2 como SALIDAS (LEDs de Carga: Pines A0-A2)
    out DDRC, TEMP

    ; 3. Inicialización de Variables
    clr STATE             ; Arrancar en Estado E0 (Listo)
    clr LOAD              ; Arrancar en Carga Ligera (0)

; BUCLE PRINCIPAL DE LA MÁQUINA DE ESTADOS (FSM)
FSM_LOOP:
    cpi STATE, 0
    breq STATE_E0
    cpi STATE, 1
    breq STATE_E1
    cpi STATE, 2
    breq STATE_E2
    cpi STATE, 3
    breq STATE_E3
    cpi STATE, 4
    breq STATE_E4
    rjmp FSM_LOOP

; E0: ESTADO LISTO
; Salida: LED_Listo (PB0 / Pin 8) ON. Selección de carga mediante PORTC.
STATE_E0:
    ldi TEMP, (1<<PB0)
    out PORTB, TEMP       ; Activa únicamente el LED de Estado Listo
    rcall UPDATE_LOAD_LEDS; Refresca el indicador LED del nivel de carga actual

    ; Verificar pulsador de cambio de carga (PD3)
    sbic PIND, P_CARGA
    rcall CHANGE_LOAD

    ; Evaluación de transición a E1: Requiere P_INICIO (PD2)=1 Y S_PUERTA (PD4)=1
    sbis PIND, P_INICIO
    rjmp FSM_LOOP
    sbis PIND, S_PUERTA
    rjmp FSM_LOOP
    
    inc STATE              ; Avanzar a E1 (Lavado)
    rjmp FSM_LOOP

; --- E1: LAVADO ---
STATE_E1:
    ldi TEMP, (1<<PB1)     ; Enciende INMEDIATAMENTE el LED Lavado (Pin 9)
    out PORTB, TEMP
WAIT_WATER:
    sbis PIND, S_AGUA      ; Espera a que el tanque esté lleno (PD5 = 1)
    rjmp WAIT_WATER

    ldi COUNTER, 5
WASH_CYCLE: 
    ; 1. GIRO: Enciende LED Lavado y espera (2s + LOAD)
    ldi TEMP, (1<<PB1)
    out PORTB, TEMP
    ldi SECONDS, 2
    add SECONDS, LOAD
    rcall DELAY_N_SEC

    ; 2. PAUSA: Apaga el LED y espera (1s + LOAD) para visualizar el parpadeo
    clr TEMP
    out PORTB, TEMP
    ldi SECONDS, 1
    add SECONDS, LOAD
    rcall DELAY_N_SEC

    dec COUNTER
    brne WASH_CYCLE
    inc STATE
    rjmp FSM_LOOP

; --- E2: CENTRIFUGADO ---
STATE_E2:
    ldi TEMP, (1<<PB2)     ; Enciende LED Centrifugado (Pin 10)
    out PORTB, TEMP
    
    ; Centrifugado dinámico (15s base + 3s por carga)
    ldi SECONDS, 15
    cpi LOAD, 0
    breq RUN_SPIN
    cpi LOAD, 1
    brne SPIN_HEAVY
    ldi SECONDS, 18
    rjmp RUN_SPIN
SPIN_HEAVY:
    ldi SECONDS, 21
RUN_SPIN:
    rcall DELAY_N_SEC

    inc STATE
    rjmp FSM_LOOP

; --- E3: SECADO ---
STATE_E3:
    ldi TEMP, (1<<PB3)     ; Enciende LED Secado (Pin 11)
    out PORTB, TEMP

    ; Giro Der (5s+2*LOAD) -> Pausa (3s+2*LOAD) -> Giro Izq (5s+2*LOAD)
    ldi SECONDS, 5
    mov TEMP, LOAD
    lsl TEMP
    add SECONDS, TEMP
    rcall DELAY_N_SEC

    ldi SECONDS, 3
    mov TEMP, LOAD
    lsl TEMP
    add SECONDS, TEMP
    rcall DELAY_N_SEC

    ldi SECONDS, 5
    mov TEMP, LOAD
    lsl TEMP
    add SECONDS, TEMP
    rcall DELAY_N_SEC

    inc STATE
    rjmp FSM_LOOP

; --- E4: FIN ---
STATE_E4:
    ldi TEMP, (1<<PB4)     ; Enciende LED Fin (Pin 12)
    out PORTB, TEMP
WAIT_DOOR_OPEN:
    sbic PIND, S_PUERTA
    rjmp WAIT_DOOR_OPEN
    clr STATE              ; Reinicia a E0 al abrir la puerta
    rjmp FSM_LOOP

; SUBRUTINAS
CHANGE_LOAD:
    rcall DELAY_DEBOUNCE
    inc LOAD
    cpi LOAD, 3
    brne WAIT_RELEASE
    clr LOAD
WAIT_RELEASE:
    rcall UPDATE_LOAD_LEDS ; Actualiza inmediatamente el LED al cambiar
WAIT_LOOP:
    sbic PIND, P_CARGA     ; Espera activa a que el switch vuelva a 0 (se suelte)
    rjmp WAIT_LOOP
    rcall DELAY_DEBOUNCE
    ret

UPDATE_LOAD_LEDS:
    cpi LOAD, 0
    breq LED_LIGHT
    cpi LOAD, 1
    breq LED_MEDIUM
    
    ldi TEMP, (1<<PC2)     ; Carga Pesada (A2)
    out PORTC, TEMP
    ret

LED_LIGHT:
    ldi TEMP, (1<<PC0)     ; Carga Ligera (A0)
    out PORTC, TEMP
    ret

LED_MEDIUM:
    ldi TEMP, (1<<PC1)     ; Carga Media (A1)
    out PORTC, TEMP
    ret

; SUBRUTINA OPTIMIZADA
DELAY_1S:
    ldi r20, 5
    ldi r21, 50
    ldi r22, 100
L1: dec r22
    brne L1
    dec r21
    brne L1
    dec r20
    brne L1
    ret

DELAY_DEBOUNCE:
    ldi r20, 2
    ldi r21, 150
L2: dec r21
    brne L2
    dec r20
    brne L2
    ret

; Subrutina para procesar N segundos dinámicos
DELAY_N_SEC:
    tst SECONDS
    breq END_DELAY_N
LOOP_N_SEC:
    rcall DELAY_1S
    dec SECONDS
    brne LOOP_N_SEC
END_DELAY_N:
    ret