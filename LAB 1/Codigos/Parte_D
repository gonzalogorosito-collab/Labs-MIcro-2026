; Entradas:
;   PD2 (D2) - A0            PC0 (A0) - B0
;   PD3 (D3) - A1            PC1 (A1) - B1
;   PD4 (D4) - A2            PC2 (A2) - B2
;   PD5 (D5) - A3            PC3 (A3) - B3
;   PD6 (D6) - S1            PC4 (A4) - S2
;   PD7 (D7) - S0
;   (todas con pull-up interno, interruptor a GND; logica invertida por
;   software para que interruptor accionado = 1)
;
; Salidas:
;   PB0 (D8)  - F0
;   PB1 (D9)  - F1
;   PB2 (D10) - F2
;   PB3 (D11) - F3
;   PB4 (D12) - Z (bandera Zero)
;   PB5 (D13) - N (bandera Negativo)
;   PC5 (A5)  - C (bandera Carry)
;
; Funcionamiento: ALU combinacional de 4 bits (ver tabla S2 S1 S0 de
; operaciones). El resultado se actualiza en forma continua segun el
; estado de los interruptores.

.include "m328pdef.inc"

.ORG 0x0000
    RJMP RESET

RESET:
    ; Configuracion del Stack Pointer
    LDI  R16, LOW(RAMEND)
    OUT  SPL, R16
    LDI  R16, HIGH(RAMEND)
    OUT  SPH, R16

    ; --- Configuracion de puertos ---
    ; PORTD: PD2-PD5 = A0-A3 (entrada), PD6-PD7 = S1,S0 (entrada)
    LDI  R16, 0b00000000
    OUT  DDRD, R16
    LDI  R16, 0b11111100
    OUT  PORTD, R16

    ; PORTC: PC0-PC3 = B0-B3 (entrada), PC4 = S2 (entrada), PC5 = C (salida)
    LDI  R16, 0b00100000
    OUT  DDRC, R16
    LDI  R16, 0b00011111
    OUT  PORTC, R16

    ; PORTB: PB0-PB3 = F0-F3, PB4 = Z, PB5 = N (todas salidas)
    LDI  R16, 0b00111111
    OUT  DDRB, R16
    LDI  R16, 0b00000000
    OUT  PORTB, R16

MAIN:
    IN   R16, PINC
    COM  R16
    ANDI R16, 0b00001111
    OUT  PORTB, R16
    RJMP MAIN