; Entradas:
;   PD2 (D2) - A0            PC0 (A0) - B0
;   PD3 (D3) - A1            PC1 (A1) - B1
;   PD4 (D4) - A2            PC2 (A2) - B2
;   PD5 (D5) - A3            PC3 (A3) - B3
;   PD6 (D6) - S0            PC4 (A4) - S2
;   PD7 (D7) - S1
;   (todas con pull-up interno, interruptor a GND; logica invertida por
;   software para que interruptor accionado = 1)
;
; Salidas:
;   PB0 (D8)  - F0
;   PB1 (D9)  - F1
;   PB2 (D10) - F2
;   PB3 (D11) - F3
;   PB4 (D12) - Z (bandera Zero)
;   PB5 (D13) - N (bandera Negativo)
;   PC5 (A5)  - C (bandera Carry)
;
; Funcionamiento: ALU combinacional de 4 bits (ver tabla S2 S1 S0 de
; operaciones). El resultado y las banderas se actualizan en forma
; continua segun el estado de los interruptores.

.include "m328pdef.inc"

.ORG 0x0000
    RJMP RESET

RESET:
    ; Configuracion del Stack Pointer
    LDI  R16, LOW(RAMEND)
    OUT  SPL, R16
    LDI  R16, HIGH(RAMEND)
    OUT  SPH, R16

    ; --- Configuracion de puertos ---
    LDI  R16, 0b00000000
    OUT  DDRD, R16
    LDI  R16, 0b11111100
    OUT  PORTD, R16

    LDI  R16, 0b00100000
    OUT  DDRC, R16
    LDI  R16, 0b00011111
    OUT  PORTC, R16

    LDI  R16, 0b00111111
    OUT  DDRB, R16
    LDI  R16, 0b00000000
    OUT  PORTB, R16

; --- Bucle principal ---
MAIN:
    RCALL LEER_A
    RCALL LEER_B
    RCALL LEER_S

    CPI  R16, 0
    BREQ OP_CLEAR
    CPI  R16, 1
    BREQ OP_A_MENOS_B
    CPI  R16, 2
    BREQ OP_A_MAS_B
    CPI  R16, 3
    BREQ OP_XOR
    CPI  R16, 4
    BREQ OP_AND
    CPI  R16, 5
    BREQ OP_OR
    CPI  R16, 6
    BREQ OP_SHL
    CPI  R16, 7
    BREQ OP_INC

    RJMP MAIN

; --- Operaciones de la ALU ---
OP_CLEAR:
    CLR  R21
    CLR  R23
    RJMP ACTUALIZAR_SALIDA

OP_A_MENOS_B:
    MOV  R21, R17
    SUB  R21, R18
    CLR  R23
    BRCC OP_A_MENOS_B_FIN
    LDI  R23, 1
OP_A_MENOS_B_FIN:
    RJMP ACTUALIZAR_SALIDA

OP_A_MAS_B:
    MOV  R21, R17
    ADD  R21, R18
    CLR  R23
    SBRC R21, 4
    LDI  R23, 1
    RJMP ACTUALIZAR_SALIDA

OP_XOR:
    MOV  R21, R17
    EOR  R21, R18
    CLR  R23
    RJMP ACTUALIZAR_SALIDA

OP_AND:
    MOV  R21, R17
    AND  R21, R18
    CLR  R23
    RJMP ACTUALIZAR_SALIDA

OP_OR:
    MOV  R21, R17
    OR   R21, R18
    CLR  R23
    RJMP ACTUALIZAR_SALIDA

OP_SHL:
    MOV  R21, R17
    CLR  R23
    SBRC R17, 3
    LDI  R23, 1
    LSL  R21
    RJMP ACTUALIZAR_SALIDA

OP_INC:
    MOV  R21, R17
    INC  R21
    CLR  R23
    SBRC R21, 4
    LDI  R23, 1
    RJMP ACTUALIZAR_SALIDA

; --- Calculo de banderas y salida ---
ACTUALIZAR_SALIDA:
    ANDI R21, 0b00001111

    CPI  R21, 0
    BRNE NO_ZERO
    LDI  R24, 1
    RJMP FIN_ZERO
NO_ZERO:
    CLR  R24
FIN_ZERO:

    MOV  R25, R21
    ANDI R25, 0b00001000
    BREQ NO_NEG
    LDI  R25, 1
    RJMP FIN_NEG
NO_NEG:
    CLR  R25
FIN_NEG:

    MOV  R26, R24
    LSL  R26
    LSL  R26
    LSL  R26
    LSL  R26
    OR   R21, R26

    MOV  R26, R25
    LSL  R26
    LSL  R26
    LSL  R26
    LSL  R26
    LSL  R26
    OR   R21, R26

    OUT  PORTB, R21

    MOV  R26, R23
    LSL  R26
    LSL  R26
    LSL  R26
    LSL  R26
    LSL  R26
    ORI  R26, 0b00011111
    OUT  PORTC, R26

    RJMP MAIN

; --- Lectura de entradas ---
LEER_A:
    IN   R17, PIND
    COM  R17
    LSR  R17
    LSR  R17
    ANDI R17, 0b00001111
    RET

LEER_B:
    IN   R18, PINC
    COM  R18
    ANDI R18, 0b00001111
    RET

LEER_S:
    IN   R16, PIND
    COM  R16
    LSR  R16
    LSR  R16
    LSR  R16
    LSR  R16
    LSR  R16
    LSR  R16
    ANDI R16, 0b00000011

    IN   R20, PINC
    COM  R20
    LSR  R20
    LSR  R20
    LSR  R20
    LSR  R20
    ANDI R20, 0b00000001
    LSL  R20
    LSL  R20

    OR   R16, R20
    RET