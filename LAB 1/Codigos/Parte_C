; =====================================================================
; PRÁCTICA C: Selección y ejecución de 8 secuencias de LEDs
; =====================================================================
.include "m328pdef.inc"
; --- Definición de Registros ---
.def TEMP        = R16  ; Registro de trabajo general
.def SECUENCIAS  = R17  ; Contador de secuencia actual (1 a 8)
.def LED_PATRON  = R18  ; Registro para el patrón de los LEDs
.def R_DELAY1    = R19  ; Registro 1 para retardo
.def R_DELAY2    = R20  ; Registro 2 para retardo
.def R_DELAY3    = R21  ; Registro 3 para retardo
; --- Vector de Reset ---
.org 0x0000
    rjmp RESET
RESET:
    ; 1. Inicializar el Stack Pointer
    ldi TEMP, LOW(RAMEND)
    out SPL, TEMP
    ldi TEMP, HIGH(RAMEND)
    out SPH, TEMP
    ; 2. Configuración de Puertos E/S
    ldi TEMP, 0xFF
    out DDRD, TEMP      ; Puerto D como SALIDA (8 LEDs)
    clr TEMP
    out PORTD, TEMP     ; Inicializar LEDs apagados
    clr TEMP
    out DDRB, TEMP      ; PB0-PB2 como entradas
    ldi TEMP, 0x07      ; Habilitar Pull-Up en PB0, PB1 y PB2
    out PORTB, TEMP
    ; 3. Inicializar en Secuencia 1
    ldi SECUENCIAS, 1
; =====================================================================
; BUCLE PRINCIPAL (Evaluador de Secuencias con saltos largos)
; =====================================================================
MAIN_LOOP:
    rcall LEER_BOTONES
    cpi SECUENCIAS, 1
    brne CHK_2
    jmp EJECUTAR_SEC1
CHK_2:
    cpi SECUENCIAS, 2
    brne CHK_3
    jmp EJECUTAR_SEC2
CHK_3:
    cpi SECUENCIAS, 3
    brne CHK_4
    jmp EJECUTAR_SEC3
CHK_4:
    cpi SECUENCIAS, 4
    brne CHK_5
    jmp EJECUTAR_SEC4
CHK_5:
    cpi SECUENCIAS, 5
    brne CHK_6
    jmp EJECUTAR_SEC5
CHK_6:
    cpi SECUENCIAS, 6
    brne CHK_7
    jmp EJECUTAR_SEC6
CHK_7:
    cpi SECUENCIAS, 7
    brne CHK_8
    jmp EJECUTAR_SEC7
CHK_8:
    cpi SECUENCIAS, 8
    brne MAIN_LOOP
    jmp EJECUTAR_SEC8
; =====================================================================
; MÓDULO: LECTURA DE BOTONES Y NAVEGACIÓN
; =====================================================================
LEER_BOTONES:
    in TEMP, PINB       ; Leer entradas de Puerto B
    ; Botón 3: Inicio (PB2)
    sbrs TEMP, 2
    rjmp BTN_INICIO
    ; Botón 1: Avanzar (PB0)
    sbrs TEMP, 0
    rjmp BTN_AVANZAR
    ; Botón 2: Retroceder (PB1)
    sbrs TEMP, 1
    rjmp BTN_RETROCEDER
    ret
BTN_INICIO:
    rcall ANTIRREBOTE
    ldi SECUENCIAS, 1   ; Reiniciar directamente a Secuencia 1
    ret
BTN_AVANZAR:
    rcall ANTIRREBOTE
    inc SECUENCIAS
    cpi SECUENCIAS, 9   ; Si supera 8, vuelve a 1
    brne FIN_BOTON
    ldi SECUENCIAS, 1
FIN_BOTON:
    ret
BTN_RETROCEDER:
    rcall ANTIRREBOTE
    dec SECUENCIAS
    cpi SECUENCIAS, 0   ; Si baja de 1, salta a 8
    brne FIN_BOTON
    ldi SECUENCIAS, 8
    ret
; =====================================================================
; MÓDULO: 8 SECUENCIAS LUMINOSAS
; =====================================================================
; --- Secuencia 1: Auto Fantástico (Izquierda) ---
EJECUTAR_SEC1:
    ldi LED_PATRON, 0x01
S1_LOOP:
    out PORTD, LED_PATRON
    rcall DELAY_LUM
    rcall LEER_BOTONES
    lsl LED_PATRON
    brne S1_LOOP
    rjmp MAIN_LOOP
; --- Secuencia 2: Auto Fantástico (Derecha) ---
EJECUTAR_SEC2:
    ldi LED_PATRON, 0x80
S2_LOOP:
    out PORTD, LED_PATRON
    rcall DELAY_LUM
    rcall LEER_BOTONES
    lsr LED_PATRON
    brne S2_LOOP
    rjmp MAIN_LOOP
EJECUTAR_SEC3:
    rjmp MAIN_LOOP
EJECUTAR_SEC4:
    rjmp MAIN_LOOP
EJECUTAR_SEC5:
    rjmp MAIN_LOOP
EJECUTAR_SEC6:
    rjmp MAIN_LOOP
EJECUTAR_SEC7:
    rjmp MAIN_LOOP
EJECUTAR_SEC8:
    rjmp MAIN_LOOP
; =====================================================================
; MÓDULO: RUTINAS DE RETARDO Y ANTIRREBOTE
; =====================================================================
ANTIRREBOTE:
    ldi R_DELAY1, 100
DELAY_ANTI:
    dec R_DELAY1
    brne DELAY_ANTI
    ret
DELAY_LUM:
    ldi R_DELAY1, 20
    ldi R_DELAY2, 150
    ldi R_DELAY3, 150
L1: dec R_DELAY3
    brne L1
    dec R_DELAY2
    brne L1
    dec R_DELAY1
    brne L1
    ret
