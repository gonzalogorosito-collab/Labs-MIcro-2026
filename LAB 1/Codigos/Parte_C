; =====================================================================
; PRÁCTICA C: Selección y ejecución de 8 secuencias de LEDs
; =====================================================================
.include "m328pdef.inc"
; --- Definición de Registros ---
.def TEMP        = R16  ; Registro de trabajo general
.def SECUENCIAS  = R17  ; Contador de secuencia actual (1 a 8)
.def R_DELAY1    = R19  ; Registro para retardo antirrebote
; --- Vector de Reset ---
.org 0x0000
    rjmp RESET
RESET:
    ; 1. Inicializar el Stack Pointer
    ldi TEMP, LOW(RAMEND)
    out SPL, TEMP
    ldi TEMP, HIGH(RAMEND)
    out SPH, TEMP
    ; 2. Configuración de Puertos E/S
    ldi TEMP, 0xFF
    out DDRD, TEMP      ; Puerto D como SALIDA (8 LEDs)
    clr TEMP
    out PORTD, TEMP     ; Inicializar LEDs apagados
    clr TEMP
    out DDRB, TEMP      ; PB0-PB2 como entradas
    ldi TEMP, 0x07      ; Habilitar Pull-Up en PB0, PB1 y PB2
    out PORTB, TEMP
    ; 3. Inicializar en Secuencia 1
    ldi SECUENCIAS, 1
; =====================================================================
; BUCLE PRINCIPAL (todavía sin secuencias, solo lee botones)
; =====================================================================
MAIN_LOOP:
    rcall LEER_BOTONES
    rjmp MAIN_LOOP
; =====================================================================
; MÓDULO: LECTURA DE BOTONES Y NAVEGACIÓN
; =====================================================================
LEER_BOTONES:
    in TEMP, PINB       ; Leer entradas de Puerto B
    ; Botón 3: Inicio (PB2)
    sbrs TEMP, 2
    rjmp BTN_INICIO
    ; Botón 1: Avanzar (PB0)
    sbrs TEMP, 0
    rjmp BTN_AVANZAR
    ; Botón 2: Retroceder (PB1)
    sbrs TEMP, 1
    rjmp BTN_RETROCEDER
    ret
BTN_INICIO:
    rcall ANTIRREBOTE
    ldi SECUENCIAS, 1   ; Reiniciar directamente a Secuencia 1
    ret
BTN_AVANZAR:
    rcall ANTIRREBOTE
    inc SECUENCIAS
    cpi SECUENCIAS, 9   ; Si supera 8, vuelve a 1
    brne FIN_BOTON
    ldi SECUENCIAS, 1
FIN_BOTON:
    ret
BTN_RETROCEDER:
    rcall ANTIRREBOTE
    dec SECUENCIAS
    cpi SECUENCIAS, 0   ; Si baja de 1, salta a 8
    brne FIN_BOTON
    ldi SECUENCIAS, 8
    ret
; =====================================================================
; MÓDULO: ANTIRREBOTE (versión inicial, solo retardo)
; =====================================================================
ANTIRREBOTE:
    ldi R_DELAY1, 100
DELAY_ANTI:
    dec R_DELAY1
    brne DELAY_ANTI
    ret