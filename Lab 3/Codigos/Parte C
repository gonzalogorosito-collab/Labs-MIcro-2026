#define NUM_PIXELS 64

void Servo_Init(void) {
	DDRB |= (1 << PB1);
	TCCR1A = (1 << COM1A1) | (1 << WGM11);
	TCCR1B = (1 << WGM13) | (1 << WGM12) | (1 << CS11);
	ICR1 = 39999;
}

void Servo_SetAngle_OCR(uint16_t ocr_val) {
	OCR1A = ocr_val;
}

// --- Control WS2811 / WS2812 en C ---
void send_ws2812_all(uint8_t r, uint8_t g, uint8_t b) {
	for (uint16_t i = 0; i < NUM_PIXELS; i++) {
		// #ifdef MODO_SIMULACION
		// uint8_t data[3] = {g, r, b}; // Orden GRB para la simulación
		// #else
		uint8_t data[3] = {b, r, g}; // Orden B, R, G exacto para tu tira
		// #endif
		
		uint8_t *ptr = data;
		uint8_t bytesLeft = 3;

		__asm__ __volatile__ (
		"L_byte:\n\t"
		"ld r24, %a[p]+\n\t"
		"ldi r25, 8\n\t"
		"L_bit:\n\t"
		"sbi %[port], %[pin]\n\t"
		"lsl r24\n\t"
		"brcc L_zero\n\t"
		"nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t"
		"cbi %[port], %[pin]\n\t"
		"rjmp L_next\n\t"
		"L_zero:\n\t"
		"cbi %[port], %[pin]\n\t"
		"nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t" "nop\n\t"
		"L_next:\n\t"
		"subi r25, 1\n\t"
		"brne L_bit\n\t"
		"subi %[cnt], 1\n\t"
		"brne L_byte\n\t"
		: [p] "+e" (ptr), [cnt] "+d" (bytesLeft)
		: [port] "i" (_SFR_IO_ADDR(PORTD)), [pin] "i" (PD6)
		: "r24", "r25", "cc", "memory"
		);
	}
}

void LCD_Init(void) {
	twi_init();
	DDRC  &= ~(1 << PC0);
	PORTC &= ~(1 << PC0);
	twi_lcd_init();
	twi_lcd_cmd(0x0C);
}

void LCD_Print(const char *str) {
	twi_lcd_msg(str);
}

void LCD_SetCursor(uint8_t row, uint8_t col) {
	uint8_t addr = (row == 0) ? (0x80 + col) : (0xC0 + col);
	twi_lcd_cmd(addr);
}

void UART_Init(unsigned int ubrr) {
	UBRR0H = (unsigned char)(ubrr >> 8);
	UBRR0L = (unsigned char)ubrr;
	UCSR0B = (1 << TXEN0);
	UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

void UART_Transmit(unsigned char data) {
	while (!(UCSR0A & (1 << UDRE0)));
	UDR0 = data;
}

void UART_Print(const char *s) {
	while (*s) {
		UART_Transmit(*s++);
	}
}

void ADC_Init(void) {
	ADMUX = (1 << REFS0);
	ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);
}

uint16_t ADC_Read(uint8_t channel) {
	ADMUX = (ADMUX & 0xF0) | (channel & 0x0F);
	ADCSRA |= (1 << ADSC);
	while (ADCSRA & (1 << ADSC));
	return ADC;
}

uint16_t ADC_Read_Smooth(uint8_t channel) {
	uint32_t sum = 0;
	uint8_t samples = 10;
	for (uint8_t i = 0; i < samples; i++) {
		sum += ADC_Read(channel);
	}
	return (uint16_t)(sum / samples);
}

long map_value(long x, long in_min, long in_max, long out_min, long out_max) {
	if (x < in_min) x = in_min;
	if (x > in_max) x = in_max;
	return (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

int main(void) {
	DDRD |= (1 << PD6);
	UART_Init(103);
	LCD_Init();
	ADC_Init();
	Servo_Init();
	while (1) {}
}