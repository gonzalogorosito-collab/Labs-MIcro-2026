//==================== MAPEO DE PINES ====================
// PD0 (RXD)  <- TX del terminal / PC
// PD1 (TXD)  -> RX del terminal / PC
// PC0 (ADC0) <- LDR (divisor resistivo)
// PC1 (ADC1) <- Potenciometro acoplado al eje
// PD6 (OC0A) -> ENA del L298N (PWM)
// PD7        -> IN1 del L298N
// PB0        -> IN2 del L298N
//========================================================

#define F_CPU 16000000UL
#include <avr/io.h>
#include <avr/interrupt.h>
#include <stdint.h>

#define BAUD        9600
#define UBRR_VAL    ((F_CPU / (16UL * BAUD)) - 1)   // 103 -> error 0.2%
#define RX_BUF_LEN  8
#define PERIODO_TELEM  20     // 20 ticks x 10 ms = 200 ms
#define CANAL_LDR      0
#define CANAL_POT      1
#define POT_MIN        50     // Limite de carrera: persiana cerrada
#define POT_MAX        973    // Limite de carrera: persiana abierta
#define DIR_STOP       0
#define DIR_HOR        1      // Horario: abre la persiana, POT sube
#define DIR_ANTI       2      // Antihorario: cierra la persiana, POT baja

//==================== VARIABLES GLOBALES ====================
volatile char    rx_buf[RX_BUF_LEN];
volatile uint8_t rx_idx = 0;
volatile uint8_t linea_lista = 0;     // 1 = hay una linea completa para procesar
volatile uint8_t tick = 0;            // 1 = paso un tick de 10 ms
uint8_t pwm_actual = 0;               // PWM aplicado al motor (0-255)
uint8_t dir_actual = DIR_STOP;        // Sentido de giro aplicado

uint8_t setpoint = 50;                // Setpoint de iluminacion en %

//==================== UART ====================
void uart_init(void) {
	UBRR0H = (uint8_t)(UBRR_VAL >> 8);
	UBRR0L = (uint8_t)UBRR_VAL;
	UCSR0B = (1 << RXEN0) | (1 << TXEN0) | (1 << RXCIE0);  // RX, TX e interrupcion de RX
	UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);                // 8N1
}

void uart_putc(char c) {
	while (!(UCSR0A & (1 << UDRE0)));   // Esperar buffer de transmision vacio
	UDR0 = c;
}

void uart_puts(const char *s) {
	while (*s) uart_putc(*s++);
}

void uart_putu16(uint16_t n) {
	char d[5];
	uint8_t i = 0;
	do { d[i++] = '0' + (n % 10); n /= 10; } while (n);
	while (i) uart_putc(d[--i]);
}

// --- Recepcion: acumula caracteres hasta fin de linea ---
ISR(USART_RX_vect) {
	char c = UDR0;
	if (linea_lista) return;                     // main aun no proceso la linea anterior
	if (c == '\r' || c == '\n') {
		if (rx_idx > 0) {                        // ignora lineas vacias (CR+LF)
			rx_buf[rx_idx] = '\0';
			linea_lista = 1;
		}
		} else if (rx_idx < RX_BUF_LEN - 1) {
		rx_buf[rx_idx++] = c;
	}
}

//==================== TIMER1: BASE DE TIEMPO ====================
void timer1_init(void) {
	TCCR1A = 0;
	TCCR1B = (1 << WGM12) | (1 << CS11) | (1 << CS10);  // CTC, prescaler 64
	OCR1A  = 2499;                                      // 16 MHz / 64 = 250 kHz -> 2500 cuentas = 10 ms
	TIMSK1 = (1 << OCIE1A);
}

ISR(TIMER1_COMPA_vect) {
	tick = 1;
}

//==================== ADC ====================
void adc_init(void) {
	ADMUX  = (1 << REFS0);                                  // Referencia AVCC, ajuste a derecha
	ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);  // Prescaler 128 -> 125 kHz
	DIDR0  = (1 << ADC0D) | (1 << ADC1D);                   // Deshabilita entradas digitales en PC0 y PC1
}

uint16_t adc_leer(uint8_t canal) {
	ADMUX = (ADMUX & 0xF0) | (canal & 0x0F);   // Selecciona canal sin tocar la referencia
	ADCSRA |= (1 << ADSC);                     // Inicia conversion
	while (ADCSRA & (1 << ADSC));              // Espera fin de conversion
	return ADC;
}

//==================== MOTOR (L298N) ====================
void motor_init(void) {
	DDRD |= (1 << PD6) | (1 << PD7);                       // ENA e IN1 como salidas
	DDRB |= (1 << PB0);                                    // IN2 como salida
	TCCR0A = (1 << COM0A1) | (1 << WGM01) | (1 << WGM00);  // Fast PWM, OC0A no invertido
	TCCR0B = (1 << CS01) | (1 << CS00);                    // Prescaler 64 -> 16 MHz / (64 * 256) = 976 Hz
	OCR0A = 0;
}

void motor_aplicar(uint8_t dir, uint8_t pwm, uint16_t pot) {
	// Bloqueo por limite de carrera o PWM nulo
	if ((dir == DIR_HOR && pot >= POT_MAX) || (dir == DIR_ANTI && pot <= POT_MIN) || pwm == 0) {
		dir = DIR_STOP;
		pwm = 0;
	}

	switch (dir) {
		case DIR_HOR:                         // IN1=1, IN2=0
		PORTD |=  (1 << PD7);
		PORTB &= ~(1 << PB0);
		break;
		case DIR_ANTI:                        // IN1=0, IN2=1
		PORTD &= ~(1 << PD7);
		PORTB |=  (1 << PB0);
		break;
		default:                              // IN1=0, IN2=0: detenido aunque OC0A deje un pulso minimo con OCR0A=0
		PORTD &= ~(1 << PD7);
		PORTB &= ~(1 << PB0);
		break;
	}

	OCR0A = pwm;
	dir_actual = dir;
	pwm_actual = pwm;
}

//==================== PARSEO DEL SETPOINT ====================
// Devuelve 1 si la linea es un entero valido entre 0 y 100
uint8_t parsear_setpoint(const volatile char *s, uint8_t *valor) {
	uint16_t v = 0;
	if (*s == '\0') return 0;
	while (*s) {
		if (*s < '0' || *s > '9') return 0;
		v = v * 10 + (*s - '0');
		if (v > 100) return 0;
		s++;
	}
	*valor = (uint8_t)v;
	return 1;
}

//==================== MAIN ====================
int main(void) {
	uint8_t  cont_telem = 0;
	uint16_t pot = 0;
	uint8_t  ldr_pct = 0;

	uart_init();
	adc_init();
	timer1_init();
	motor_init();
	sei();

	uart_puts("Control de iluminacion - Ingrese setpoint (0-100):\r\n");

	while (1) {
		// --- Procesar setpoint recibido ---
		if (linea_lista) {
			uint8_t nuevo;
			if (parsear_setpoint(rx_buf, &nuevo)) {
				setpoint = nuevo;
				uart_puts("Setpoint: ");
				uart_putu16(setpoint);
				uart_puts("%\r\n");
				} else {
				uart_puts("Error: ingrese un entero entre 0 y 100\r\n");
			}
			rx_idx = 0;
			linea_lista = 0;
		}

		// --- Cada 10 ms: lectura de sensores y control del motor ---
		if (tick) {
			tick = 0;

			uint16_t ldr_raw = adc_leer(CANAL_LDR);
			pot     = adc_leer(CANAL_POT);
			ldr_pct = (uint8_t)(((uint32_t)ldr_raw * 100 + 511) / 1023);  // 0-1023 -> 0-100 redondeado

			// PRUEBA EN LAZO ABIERTO (se reemplaza en la Parte 4): 50% = detenido
			if (setpoint > 50) {
				motor_aplicar(DIR_HOR, (uint8_t)((setpoint - 50) * 255 / 50), pot);
				} else if (setpoint < 50) {
				motor_aplicar(DIR_ANTI, (uint8_t)((50 - setpoint) * 255 / 50), pot);
				} else {
				motor_aplicar(DIR_STOP, 0, pot);
			}

			// --- Telemetria cada 200 ms ---
			if (++cont_telem >= PERIODO_TELEM) {
				cont_telem = 0;

				uart_puts("SP=");   uart_putu16(setpoint);
				uart_puts(",LDR="); uart_putu16(ldr_pct);
				uart_puts(",POT="); uart_putu16(pot);
				uart_puts(",PWM="); uart_putu16(pwm_actual);
				uart_puts(",DIR=");
				uart_putc(dir_actual == DIR_HOR ? 'H' : (dir_actual == DIR_ANTI ? 'A' : 'S'));
				uart_puts("\r\n");
			}
		}
	}
}