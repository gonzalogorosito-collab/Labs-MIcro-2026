#define F_CPU    16000000UL
#define PCF8574  0x20           // Proteus: 0x20 | Módulo físico: 0x27 o 0x3F

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdio.h>
#include <stdint.h>
#include "twi_lcd.h"

//===================== MAPEO DE PINES =====================
// Pin 0 (PD0)  -> RX de la USART
// Pin 1 (PD1)  -> TX de la USART
// Pin 2 (PD2)  -> DATA del DHT11
// A4 (PC4)     -> SDA del módulo LCD I2C
// A5 (PC5)     -> SCL del módulo LCD I2C
//==========================================================

#define DHT_PIN    PD2
#define DHT_LEER   ((PIND >> DHT_PIN) & 1)

#define DHT_OK         0
#define DHT_ERR_RESP   1
#define DHT_ERR_CHECK  2

#define BAUD       9600
#define UBRR_VAL   ((F_CPU / 16 / BAUD) - 1)
#define RX_LEN     16

volatile char    rx_buffer[RX_LEN];
volatile uint8_t rx_idx = 0;
volatile uint8_t rx_linea_lista = 0;

//======================== USART ===========================
void uart_init(void)
{
	UBRR0H = (uint8_t)(UBRR_VAL >> 8);
	UBRR0L = (uint8_t)UBRR_VAL;                            // 103 -> 9600 baud a 16 MHz
	UCSR0B = (1 << RXEN0) | (1 << TXEN0) | (1 << RXCIE0);  // RX, TX e interrupción de recepción
	UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);                // 8 bits, sin paridad, 1 stop
}

void uart_tx(char c)
{
	while (!(UCSR0A & (1 << UDRE0)));
	UDR0 = c;
}

void uart_print(const char *s)
{
	while (*s) uart_tx(*s++);
}

// --- Recepción: acumula caracteres hasta CR o LF ---
ISR(USART_RX_vect)
{
	char c = UDR0;

	if (rx_linea_lista) return;                 // Línea anterior sin procesar: se descarta

	if (c == '\r' || c == '\n')
	{
		if (rx_idx > 0)
		{
			rx_buffer[rx_idx] = '\0';
			rx_linea_lista = 1;
			rx_idx = 0;
		}
	}
	else if (rx_idx < RX_LEN - 1)
	{
		rx_buffer[rx_idx++] = c;
	}
}

//======================== DHT11 ===========================
// --- Espera a que la línea tome el nivel indicado, con timeout en us ---
static uint8_t dht_esperar(uint8_t nivel, uint8_t timeout_us)
{
	while (DHT_LEER != nivel)
	{
		if (timeout_us-- == 0) return 0;
		_delay_us(1);
	}
	return 1;
}

uint8_t dht11_leer(uint8_t *temp, uint8_t *hum)
{
	uint8_t datos[5] = {0, 0, 0, 0, 0};
	uint8_t i, j;
	uint8_t sreg;

	// --- Pulso de inicio: línea en bajo 20 ms ---
	DDRD  |=  (1 << DHT_PIN);
	PORTD &= ~(1 << DHT_PIN);
	_delay_ms(20);

	// --- Liberar la línea y pasar a entrada (pull-up interno activo) ---
	sreg = SREG;
	cli();
	PORTD |=  (1 << DHT_PIN);
	_delay_us(30);
	DDRD  &= ~(1 << DHT_PIN);

	// --- Respuesta del sensor: 80 us bajo, 80 us alto, inicio del primer bit ---
	if (!dht_esperar(0, 100) || !dht_esperar(1, 100) || !dht_esperar(0, 100))
	{
		SREG = sreg;
		return DHT_ERR_RESP;
	}

	// --- Lectura de 40 bits: alto ~27 us = 0, alto ~70 us = 1 ---
	for (i = 0; i < 5; i++)
	{
		for (j = 0; j < 8; j++)
		{
			if (!dht_esperar(1, 80)) { SREG = sreg; return DHT_ERR_RESP; }
			_delay_us(40);
			datos[i] <<= 1;
			if (DHT_LEER)
			{
				datos[i] |= 1;
				if (!dht_esperar(0, 80)) { SREG = sreg; return DHT_ERR_RESP; }
			}
		}
	}
	SREG = sreg;

	// --- Verificación del checksum ---
	if ((uint8_t)(datos[0] + datos[1] + datos[2] + datos[3]) != datos[4])
	  return DHT_ERR_CHECK;

	*hum  = datos[0];
	*temp = datos[2];
	return DHT_OK;
}

//======================== MAIN ============================
int main(void)
{
	uint8_t temp, hum, estado;
	uint8_t k;
	char linea[17];
	char msg[40];

	DDRD  &= ~(1 << DHT_PIN);
	PORTD |=  (1 << DHT_PIN);

	uart_init();
	twi_init();
	_delay_ms(50);
	twi_lcd_init();
	twi_lcd_cmd(0x0C);          // Apaga el cursor parpadeante de la librería

	sei();
	uart_print("Sistema iniciado\r\n");

	while (1)
	{
		// --- Lectura del sensor, LCD y envío por UART ---
		estado = dht11_leer(&temp, &hum);

		if (estado == DHT_OK)
		{
			sprintf(linea, "Temp: %2u C      ", temp);
			twi_lcd_cmd(0x80);
			twi_lcd_msg(linea);
			sprintf(linea, "Hum:  %2u %%      ", hum);
			twi_lcd_cmd(0xC0);
			twi_lcd_msg(linea);

			sprintf(msg, "Temp: %u C | Hum: %u %%\r\n", temp, hum);
			uart_print(msg);
		}
		else
		{
			sprintf(linea, "Error DHT: %u    ", estado);
			twi_lcd_cmd(0x80);
			twi_lcd_msg(linea);

			sprintf(msg, "Error DHT: %u\r\n", estado);
			uart_print(msg);
		}

		// --- Espera de 2 s revisando comandos cada 10 ms ---
		for (k = 0; k < 200; k++)
		{
			if (rx_linea_lista)
			{
				uart_print("Recibido: ");
				uart_print((const char *)rx_buffer);
				uart_print("\r\n");
				rx_linea_lista = 0;
			}
			_delay_ms(10);
		}
	}
}