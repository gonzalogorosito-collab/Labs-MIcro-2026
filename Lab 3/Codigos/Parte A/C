#define F_CPU    16000000UL
#define PCF8574  0x20           // Proteus: 0x20 | Módulo físico: 0x27

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdio.h>
#include <stdint.h>
#include "twi_lcd.h"

//===================== MAPEO DE PINES =====================
// Pin 0 (PD0)  -> RX de la USART
// Pin 1 (PD1)  -> TX de la USART
// Pin 2 (PD2)  -> DATA del DHT11
// Pin 4 (PD4)  -> IN2 del L298N
// Pin 6 (PD6)  -> ENA del L298N (PWM, OC0A)
// Pin 7 (PD7)  -> IN1 del L298N
// Pin 8 (PB0)  -> LED del calefactor (con resistencia de 220 ohm a GND)
// A4 (PC4)     -> SDA del módulo LCD I2C
// A5 (PC5)     -> SCL del módulo LCD I2C
//==========================================================

#define DHT_PIN    PD2
#define DHT_LEER   ((PIND >> DHT_PIN) & 1)

#define DHT_OK         0
#define DHT_ERR_RESP   1
#define DHT_ERR_CHECK  2

#define BAUD       9600
#define UBRR_VAL   ((F_CPU / 16 / BAUD) - 1)
#define RX_LEN     16

#define MOTOR_ENA    PD6
#define MOTOR_IN1    PD7
#define MOTOR_IN2    PD4
#define CALEF_PIN    PB0

#define DUTY_BAJA    102        // 40 %
#define DUTY_MEDIA   178        // 70 %
#define DUTY_ALTA    255        // 100 %

#define ACC_CALEF    0
#define ACC_CONFORT  1
#define ACC_BAJA     2
#define ACC_MEDIA    3
#define ACC_ALTA     4

#define PM_DEFECTO   21                         // Confort por defecto: 16-25 C
#define PM_MIN       5                          // Confort desde 0 C (mínimo del DHT11)
#define DHT_TEMP_MAX 50                         // Máximo del DHT11
#define DIST_ALTA    25                         // Distancia al punto medio de la ventilación alta
#define PM_MAX       (DHT_TEMP_MAX - DIST_ALTA) // 25: ventilación alta dentro del rango del sensor

#define MENU_INACTIVO  0
#define MENU_OPCION    1
#define MENU_VALOR     2

volatile char    rx_buffer[RX_LEN];
volatile uint8_t rx_idx = 0;
volatile uint8_t rx_linea_lista = 0;

volatile uint8_t t1_segundos = 0;
volatile uint8_t medir = 1;                 // En 1 para medir apenas arranca

uint8_t punto_medio = PM_DEFECTO;
uint8_t menu_estado = MENU_INACTIVO;

//======================== USART ===========================
void uart_init(void)
{
	UBRR0H = (uint8_t)(UBRR_VAL >> 8);
	UBRR0L = (uint8_t)UBRR_VAL;                            // 103 -> 9600 baud a 16 MHz
	UCSR0B = (1 << RXEN0) | (1 << TXEN0) | (1 << RXCIE0);  // RX, TX e interrupción de recepción
	UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);                // 8 bits, sin paridad, 1 stop
}

void uart_tx(char c)
{
	while (!(UCSR0A & (1 << UDRE0)));
	UDR0 = c;
}

void uart_print(const char *s)
{
	while (*s) uart_tx(*s++);
}

// --- Recepción: acumula caracteres hasta CR o LF ---
ISR(USART_RX_vect)
{
	char c = UDR0;

	if (rx_linea_lista) return;                 // Línea anterior sin procesar: se descarta

	if (c == '\r' || c == '\n')
	{
		if (rx_idx > 0)
		{
			rx_buffer[rx_idx] = '\0';
			rx_linea_lista = 1;
			rx_idx = 0;
		}
	}
	else if (rx_idx < RX_LEN - 1)
	{
		rx_buffer[rx_idx++] = c;
	}
}

//======================== TIMER1 ==========================
void timer1_init(void)
{
	TCCR1A = 0x00;
	TCCR1B = (1 << WGM12) | (1 << CS12) | (1 << CS10);      // CTC, prescaler 1024
	OCR1A  = 15624;                                         // 16 MHz / 1024 / 15625 = 1 Hz
	TIMSK1 = (1 << OCIE1A);                                 // Interrupción por comparación A
}

// --- Tick de 1 s: cada 5 s habilita una medición ---
ISR(TIMER1_COMPA_vect)
{
	if (++t1_segundos >= 5)
	{
		t1_segundos = 0;
		medir = 1;
	}
}

//===================== MOTOR (L298N) ======================
const uint8_t duty_vel[4] = {0, DUTY_BAJA, DUTY_MEDIA, DUTY_ALTA};

void motor_init(void)
{
	DDRD  |=  (1 << MOTOR_ENA) | (1 << MOTOR_IN1) | (1 << MOTOR_IN2);
	PORTD |=  (1 << MOTOR_IN1);                             // Sentido fijo: IN1 = 1
	PORTD &= ~(1 << MOTOR_IN2);                             //               IN2 = 0

	TCCR0A = (1 << WGM01) | (1 << WGM00);                   // Fast PWM, OC0A desconectado
	TCCR0B = (1 << CS01);                                   // Prescaler 8 -> 7,8 kHz
	OCR0A  = 0;
}

// --- vel: 0 = apagado, 1 = baja, 2 = media, 3 = alta ---
void motor_set(uint8_t vel)
{
	if (vel == 0)
	{
		TCCR0A &= ~(1 << COM0A1);                           // Desconecta OC0A del pin
		PORTD  &= ~(1 << MOTOR_ENA);                        // ENA en 0: motor apagado
	}
	else
	{
		OCR0A   = duty_vel[vel];
		TCCR0A |= (1 << COM0A1);                            // Conecta OC0A: PWM no invertido
	}
}

//=================== LÓGICA DE CONTROL ====================
const uint8_t vel_acc[5]   = {0, 0, 1, 2, 3};
const char   *lcd_acc[5]   = {"CALEF", "OK   ", "BAJA ", "MEDIA", "ALTA "};
const char   *uart_acc[5]  = {"Calefactor ON", "Confort", "Ventilador baja",
"Ventilador media", "Ventilador alta"};

// --- Tramo según la distancia de la temperatura al punto medio ---
uint8_t decidir_accion(uint8_t temp, uint8_t pm)
{
	int16_t d = (int16_t)temp - (int16_t)pm;

	if (d <= -6)       return ACC_CALEF;
	if (d <=  4)       return ACC_CONFORT;
	if (d <= 14)       return ACC_BAJA;
	if (d < DIST_ALTA) return ACC_MEDIA;
	return ACC_ALTA;
}

// --- Aplica la acción a motor, calefactor y LCD; devuelve la acción ---
uint8_t aplicar_control(uint8_t temp)
{
	uint8_t accion;
	char linea[17];

	accion = decidir_accion(temp, punto_medio);
	motor_set(vel_acc[accion]);

	if (accion == ACC_CALEF) PORTB |=  (1 << CALEF_PIN);
	else                     PORTB &= ~(1 << CALEF_PIN);

	sprintf(linea, "Temp: %2u C ", temp);
	twi_lcd_cmd(0x80);
	twi_lcd_msg(linea);
	twi_lcd_msg(lcd_acc[accion]);

	sprintf(linea, "Rango: %2u-%2u C  ", punto_medio - 5, punto_medio + 4);
	twi_lcd_cmd(0xC0);
	twi_lcd_msg(linea);

	return accion;
}

//======================= MENÚ UART ========================
void mostrar_menu(void)
{
	uart_print("\r\n========== MENU ==========\r\n");
	uart_print("1 - Cambiar punto medio\r\n");
	uart_print("2 - Ver estado actual\r\n");
	uart_print("0 - Salir\r\n");
	uart_print("(Monitoreo pausado con el menu abierto)\r\n");
	uart_print("Opcion: ");
}

void mostrar_estado(uint8_t temp, uint8_t accion, uint8_t valido)
{
	char msg[48];

	sprintf(msg, "\r\nPunto medio: %u | Confort: %u-%u C\r\n",
	punto_medio, punto_medio - 5, punto_medio + 4);
	uart_print(msg);

	if (valido)
	{
		sprintf(msg, "Ultima temp: %u C | Accion: ", temp);
		uart_print(msg);
		uart_print(uart_acc[accion]);
		uart_print("\r\n");
	}
	else
	{
		uart_print("Sin mediciones validas todavia\r\n");
	}
}

// --- Convierte texto a número; devuelve 0 si no es un entero válido ---
uint8_t leer_numero(const char *s, uint8_t *valor)
{
	uint16_t n = 0;
	uint8_t i = 0;

	if (s[0] == '\0') return 0;

	while (s[i] != '\0')
	{
		if (s[i] < '0' || s[i] > '9' || i >= 3) return 0;
		n = n * 10 + (s[i] - '0');
		i++;
	}
	*valor = (uint8_t)n;
	return 1;
}

// --- Máquina de estados del menú; devuelve 1 si cambió el punto medio ---
uint8_t procesar_linea(const char *cmd, uint8_t temp, uint8_t accion, uint8_t valido)
{
	uint8_t valor;
	char msg[100];

	switch (menu_estado)
	{
		case MENU_INACTIVO:
		if ((cmd[0] == 'M' || cmd[0] == 'm') && cmd[1] == '\0')
		{
			menu_estado = MENU_OPCION;
			mostrar_menu();
		}
		else
		{
			uart_print("Comando no reconocido. Envie M para abrir el menu\r\n");
		}
		break;

		case MENU_OPCION:
		if (cmd[0] == '1' && cmd[1] == '\0')
		{
			menu_estado = MENU_VALOR;
			sprintf(msg, "\r\nIngrese el nuevo punto medio (%u-%u): ", PM_MIN, PM_MAX);
			uart_print(msg);
		}
		else if (cmd[0] == '2' && cmd[1] == '\0')
		{
			mostrar_estado(temp, accion, valido);
			mostrar_menu();
		}
		else if (cmd[0] == '0' && cmd[1] == '\0')
		{
			menu_estado = MENU_INACTIVO;
			uart_print("\r\nMenu cerrado. Monitoreo reanudado\r\n");
		}
		else
		{
			uart_print("\r\nOpcion invalida\r\n");
			mostrar_menu();
		}
		break;

		case MENU_VALOR:
		if (!leer_numero(cmd, &valor))
		{
			sprintf(msg, "\r\nValor invalido. Ingrese un entero (%u-%u): ", PM_MIN, PM_MAX);
			uart_print(msg);
		}
		else if (valor > PM_MAX)
		{
			sprintf(msg, "\r\nRechazado: la ventilacion alta empezaria en %u C y supera el maximo del DHT11 (%u C)\r\n",
			valor + DIST_ALTA, DHT_TEMP_MAX);
			uart_print(msg);
			menu_estado = MENU_OPCION;
			mostrar_menu();
		}
		else if (valor < PM_MIN)
		{
			uart_print("\r\nRechazado: el rango de confort quedaria por debajo de 0 C (minimo del DHT11)\r\n");
			menu_estado = MENU_OPCION;
			mostrar_menu();
		}
		else
		{
			punto_medio = valor;
			sprintf(msg, "\r\nPunto medio actualizado: %u | Confort: %u-%u C\r\n",
			punto_medio, punto_medio - 5, punto_medio + 4);
			uart_print(msg);
			uart_print("Menu cerrado. Monitoreo reanudado\r\n");
			menu_estado = MENU_INACTIVO;
			return 1;
		}
		break;
	}
	return 0;
}

//======================== DHT11 ===========================
// --- Espera a que la línea tome el nivel indicado, con timeout en us ---
static uint8_t dht_esperar(uint8_t nivel, uint8_t timeout_us)
{
	while (DHT_LEER != nivel)
	{
		if (timeout_us-- == 0) return 0;
		_delay_us(1);
	}
	return 1;
}

uint8_t dht11_leer(uint8_t *temp, uint8_t *hum)
{
	uint8_t datos[5] = {0, 0, 0, 0, 0};
	uint8_t i, j;
	uint8_t sreg;

	// --- Pulso de inicio: línea en bajo 20 ms ---
	DDRD  |=  (1 << DHT_PIN);
	PORTD &= ~(1 << DHT_PIN);
	_delay_ms(20);

	// --- Liberar la línea y pasar a entrada (pull-up interno activo) ---
	sreg = SREG;
	cli();
	PORTD |=  (1 << DHT_PIN);
	_delay_us(30);
	DDRD  &= ~(1 << DHT_PIN);

	// --- Respuesta del sensor: 80 us bajo, 80 us alto, inicio del primer bit ---
	if (!dht_esperar(0, 100) || !dht_esperar(1, 100) || !dht_esperar(0, 100))
	{
		SREG = sreg;
		return DHT_ERR_RESP;
	}

	// --- Lectura de 40 bits: alto ~27 us = 0, alto ~70 us = 1 ---
	for (i = 0; i < 5; i++)
	{
		for (j = 0; j < 8; j++)
		{
			if (!dht_esperar(1, 80)) { SREG = sreg; return DHT_ERR_RESP; }
			_delay_us(40);
			datos[i] <<= 1;
			if (DHT_LEER)
			{
				datos[i] |= 1;
				if (!dht_esperar(0, 80)) { SREG = sreg; return DHT_ERR_RESP; }
			}
		}
	}
	SREG = sreg;

	// --- Verificación del checksum ---
	if ((uint8_t)(datos[0] + datos[1] + datos[2] + datos[3]) != datos[4])
	return DHT_ERR_CHECK;

	*hum  = datos[0];
	*temp = datos[2];
	return DHT_OK;
}

//======================== MAIN ============================
int main(void)
{
	uint8_t temp = 0, hum, estado;
	uint8_t accion = ACC_CONFORT;
	uint8_t valido = 0;
	char linea[17];
	char msg[40];

	DDRD  &= ~(1 << DHT_PIN);
	PORTD |=  (1 << DHT_PIN);

	DDRB  |=  (1 << CALEF_PIN);
	PORTB &= ~(1 << CALEF_PIN);             // Calefactor apagado al iniciar

	uart_init();
	timer1_init();
	motor_init();
	twi_init();
	_delay_ms(50);
	twi_lcd_init();
	twi_lcd_cmd(0x0C);          // Apaga el cursor parpadeante de la librería

	sei();
	uart_print("Sistema iniciado. Envie M para abrir el menu\r\n");

	while (1)
	{
		// --- Medición cada 5 s y aplicación del control ---
		if (medir)
		{
			medir = 0;
			estado = dht11_leer(&temp, &hum);

			if (estado == DHT_OK)
			{
				valido = 1;
				accion = aplicar_control(temp);

				if (menu_estado == MENU_INACTIVO)
				{
					sprintf(msg, "Temp: %u C | Accion: ", temp);
					uart_print(msg);
					uart_print(uart_acc[accion]);
					uart_print("\r\n");
				}
			}
			else
			{
				sprintf(linea, "Error DHT: %u    ", estado);
				twi_lcd_cmd(0x80);
				twi_lcd_msg(linea);

				if (menu_estado == MENU_INACTIVO)
				{
					sprintf(msg, "Error DHT: %u\r\n", estado);
					uart_print(msg);
				}
			}
		}

		// --- Atención del menú por UART ---
		if (rx_linea_lista)
		{
			if (procesar_linea((const char *)rx_buffer, temp, accion, valido) && valido)
			accion = aplicar_control(temp);     // Recalibra al instante con la última temperatura
			rx_linea_lista = 0;
		}
	}
}