.include "m328pdef.inc"

.equ F_CPU = 16000000

.org 0x0000
    jmp reset

reset:
    ; 1. Configuración del Stack Pointer
    ldi r16, LOW(RAMEND)
    out SPL, r16
    ldi r16, HIGH(RAMEND)
    out SPH, r16

    ; 2. Configuración de Puertos E/S (DAC R-2R)
    ldi r16, 0xFE
    out DDRD, r16
    ldi r16, 0x03
    out DDRB, r16

    ; --- Configuración de Botones en PC0 (A0) y PC1 (A1) con Pull-Ups ---
    ldi r16, 0x00
    out DDRC, r16       
    ldi r16, (1<<PC0) | (1<<PC1)
    out PORTC, r16      

    ; 4. Configuración del Timer0 para Control de Frecuencia (Modo CTC)
    ldi r16, (1 << WGM01)              
    out TCCR0A, r16

    ldi r22, 100                       
    out OCR0A, r22

    ldi r16, (1 << CS01) | (1 << CS00)  
    out TCCR0B, r16

    ; 6. Inicializar estado (Señal 1 por defecto)
    ldi r21, 1                          
    rcall recargar_puntero_z

bucle_principal:
    ; --- Sincronización por Temporizador (Timer0) ---
    in r16, TIFR0
    sbrs r16, OCF0A                    
    rjmp saltar_a_controles            

    ; Limpiar bandera OCF0A
    ldi r16, (1 << OCF0A)
    out TIFR0, r16

    ; Lectura de la muestra desde Flash
    lpm r16, Z+
    
    tst ZL
    brne enviar_dac
    rcall recargar_puntero_z

enviar_dac:
    ; --- Precalculo de PORTD ---
    in r17, PORTD
    andi r17, 0x03          
    mov r19, r16
    andi r19, 0x3F          
    lsl r19
    lsl r19                 
    or r17, r19             

    ; --- Precalculo de PORTB ---
    in r18, PORTB
    andi r18, 0xFC          
    mov r19, r16
    swap r19                
    lsr r19
    lsr r19                 
    andi r19, 0x03
    or r18, r19             

    ; --- ESCRITURA CONSECUTIVA ---
    out PORTD, r17
    out PORTB, r18

saltar_a_controles:
    rcall chequear_botones
    rjmp bucle_principal


; ==============================================================================
; RUTINA DE CONTROL DE BOTONES
; ==============================================================================
chequear_botones:
    sbic PINC, 0            ; Si PC0 es 1 (no presionado), salta
    rjmp check_btn2         
    rjmp inc_frec_btn       

check_btn2:
    sbic PINC, 1            ; Si PC1 es 1 (no presionado), salta
    ret                     ; Retorna si no hay botones presionados
    rjmp dec_frec_btn       

inc_frec_btn:
    cpi r22, 10
    breq esperar_soltar_inc
    subi r22, 10
    out OCR0A, r22
esperar_soltar_inc:
    sbis PINC, 0            
    rjmp esperar_soltar_inc
    ret

dec_frec_btn:
    cpi r22, 240
    breq esperar_soltar_dec
    subi r22, -10
    out OCR0A, r22
esperar_soltar_dec:
    sbis PINC, 1            
    rjmp esperar_soltar_dec
    ret


; --- Carga la dirección base de la tabla activa en Z ---
recargar_puntero_z:
    cpi r21, 1
    breq cargar_seno
    ldi ZL, LOW(lut_senal4 << 1)
    ldi ZH, HIGH(lut_senal4 << 1)
    ret
cargar_seno:
    ldi ZL, LOW(lut_seno << 1)
    ldi ZH, HIGH(lut_seno << 1)
    ret


