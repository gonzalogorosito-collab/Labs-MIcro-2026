.include "m328pdef.inc"

.equ F_CPU = 16000000

.org 0x0000
    jmp reset

reset:
    ; 1. Configuración del Stack Pointer
    ldi r16, LOW(RAMEND)
    out SPL, r16
    ldi r16, HIGH(RAMEND)
    out SPH, r16

    ; 2. Configuración de Puertos E/S (DAC R-2R)
    ldi r16, 0xFE
    out DDRD, r16
    ldi r16, 0x03
    out DDRB, r16

    ; --- Configuración de Botones en PC0 (A0) y PC1 (A1) con Pull-Ups ---
    ldi r16, 0x00
    out DDRC, r16       
    ldi r16, (1<<PC0) | (1<<PC1)
    out PORTC, r16      

    ; 4. Configuración del Timer0 para Control de Frecuencia (Modo CTC)
    ldi r16, (1 << WGM01)              
    out TCCR0A, r16

    ldi r22, 100                       
    out OCR0A, r22

    ldi r16, (1 << CS01) | (1 << CS00)  
    out TCCR0B, r16

bucle_principal:
    ; --- Sincronización por Temporizador (Timer0) ---
    in r16, TIFR0
    sbrs r16, OCF0A                    
    rjmp saltar_a_controles

    ; Limpiar bandera OCF0A
    ldi r16, (1 << OCF0A)
    out TIFR0, r16

saltar_a_controles:
    rjmp bucle_principal
