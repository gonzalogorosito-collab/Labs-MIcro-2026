;=====================================================
; PLOTTER - Selección de figuras por USART
;=====================================================
; Mapeo de pines (PORTD):
;   PD0 -> RX          PD1 -> TX
;   PD2 -> Bajar lápiz PD3 -> Subir lápiz
;   PD4 -> Abajo       PD5 -> Arriba
;   PD6 -> Derecha     PD7 -> Izquierda
;=====================================================

.INCLUDE "m328pdef.inc"

.equ F_CPU   = 16000000
.equ BAUD    = 9600
.equ UBRRVAL = 103       

.CSEG
.ORG 0x0000
    RJMP RESET

RESET:
    ; Inicializar Stack Pointer al final de la SRAM
    LDI R16, LOW(RAMEND)
    OUT SPL, R16
    LDI R16, HIGH(RAMEND)
    OUT SPH, R16

    LDI R16, 0XFC
    OUT DDRD, R16
	LDI R16, 0X00
	OUT PORTD, R16

    ; USART: 9600 baudios, 8N1
    LDI R16, LOW(UBRRVAL)
    STS UBRR0L, R16
    LDI R16, HIGH(UBRRVAL)
    STS UBRR0H, R16
    LDI R16, (1<<RXEN0) | (1<<TXEN0)
    STS UCSR0B, R16
    LDI R16, (1<<UCSZ01) | (1<<UCSZ00)
    STS UCSR0C, R16

MAIN_LOOP:
    RCALL USART_RX

    CPI R17, '1'
    BREQ Op_Tri
    CPI R17, '2'
    BREQ Op_Casa
    CPI R17, '3'
    BREQ Op_Cir
    CPI R17, '4'
    BREQ Op_Penta
    CPI R17, '5'
    BREQ Op_Poliwag
    CPI R17, 'T'
    BREQ Op_Todos

    RCALL USART_TX
    RJMP MAIN_LOOP

Op_Tri:
    RCALL Pos
    RCALL tri
    RJMP MAIN_LOOP
Op_Casa:
    RCALL Pos
    RCALL Casa
    RJMP MAIN_LOOP
Op_Cir:
    RCALL Pos
    RCALL Cir
    RJMP MAIN_LOOP
Op_Penta:
    RCALL Pos
    RCALL Penta
    RJMP MAIN_LOOP
Op_Poliwag:
    RCALL Pos
    RCALL Poliwag
    RJMP MAIN_LOOP
Op_Todos:
    RCALL Tod
    RJMP MAIN_LOOP

; --- (1) Temporización base ---
Mseg:
	RCALL Mseg_2
	RCALL Mseg_2
    NOP
    RET
Mseg_2:
	RCALL Mseg_3
	RCALL Mseg_3
    NOP
    RET

Mseg_3:
    LDI R21, 63
    LDI R22, 254
    LDI R23, 254
L1:
    DEC R23
    BRNE L1
    DEC R22
    BRNE L1
    DEC R21
    BRNE L1
    NOP
    RET

; --- (2) Temporización auxiliar (usada por Cir) ---
M4:
	RCALL M1
	RCALL M1
	RCALL M1
	RCALL M1
    NOP
    RET
Mp:
    LDI R21, 40
    LDI R22, 254
    LDI R23, 254
L3:
    DEC R23
    BRNE L3
    DEC R22
    BRNE L3
    DEC R21
    BRNE L3
    NOP
    RET

M2:
	RCALL M1
	RCALL M1
    NOP
    RET
M1:
    LDI R21, 4
    LDI R22, 254
    LDI R23, 254
L4:
    DEC R23
    BRNE L4
    DEC R22
    BRNE L4
    DEC R21
    BRNE L4
    NOP
    RET
M3:
	RCALL M1
	RCALL M1
	RCALL M1
	NOP
	RET

; --- (3) Posición inicial del plotter ---
Pos:
	LDI R17, 0X00
	LDI R17, 0X80
	OUT PORTD, R17
	RCALL Mseg
	RCALL Mseg
	RCALL Mseg
	LDI R17, 0X00
	OUT PORTD, R17
	LDI R17, 0X10
	OUT PORTD, R17
	RCALL Mseg
	LDI R17, 0X00
	OUT PORTD, R17
	RET

