	OUT PORTD, R17
	RCALL Mseg

	RCALL DER_AR
	RCALL Mseg_2

	RCALL DER_AB
	RCALL Mseg_2
	 
	RCALL IZQ
	RCALL Mseg
	LDI R17, 0X00
	OUT PORTD, R17
	LDI R17, 0X08
	OUT PORTD, R17
	RCALL Mseg
    RCALL ARS
    RCALL Mseg_3
	RCALL DER
