	OUT PORTD, R17
    RET

; --- (10) Traslados con lápiz arriba ---
ABAS:
	LDI R17, 0X18      ; abajo   + subir
	OUT PORTD, R17
	RET
ARRS:
	LDI R17, 0X28      ; arriba  + subir
	OUT PORTD, R17
	RET
DERS:
	LDI R17, 0X48      ; derecha + subir
	OUT PORTD, R17
	RET
IZQS:
	LDI R17, 0X88      ; izquierda + subir
	OUT PORTD, R17
	RET

