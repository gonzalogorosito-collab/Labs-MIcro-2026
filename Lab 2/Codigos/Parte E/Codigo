;================================================================
; Mapeo de pines:
;   PD0 - RXD (USART, manejado por hardware) - comandos del control remoto
;   PD4 - LED motor abriendo
;   PD5 - LED motor cerrando
;   (Los sensores se agregaran mas adelante en PORTC, para no
;    mezclar entradas con las salidas de este puerto)
;================================================================
.include "m328Pdef.inc"
.org 0x0000
    rjmp RESET
;================================================================
; Programa principal
;================================================================
RESET:
    ; --- Stack Pointer ---
    ldi r16, low(RAMEND)
    out SPL, r16
    ldi r16, high(RAMEND)
    out SPH, r16

    ; --- PD4:PD5 como salida ---
    ldi r16, 0b00110000
    out DDRD, r16
    clr r16
    out PORTD, r16

    ; --- Configurar USART: 9600 baudios, 8N1, solo recepcion ---
    rcall USART_INIT

MAIN_LOOP:
    ; --- Esperar comando por USART ---
    lds r16, UCSR0A
    sbrs r16, RXC0
    rjmp MAIN_LOOP
    lds r18, UDR0

    cpi r18, 'A'
    breq COMANDO_ABRIR
    cpi r18, 'C'
    breq COMANDO_CERRAR
    rjmp MAIN_LOOP

COMANDO_ABRIR:
    sbi PORTD, 4
    cbi PORTD, 5
    rjmp MAIN_LOOP

COMANDO_CERRAR:
    cbi PORTD, 4
    sbi PORTD, 5
    rjmp MAIN_LOOP

;================================================================
; USART_INIT: 9600 baudios, 8 bits, sin paridad, 1 stop (F_CPU=16MHz)
;================================================================
USART_INIT:
    ldi r16, high(103)
    sts UBRR0H, r16
    ldi r16, low(103)
    sts UBRR0L, r16
    ldi r16, (1<<RXEN0)
    sts UCSR0B, r16
    ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, r16
    ret
