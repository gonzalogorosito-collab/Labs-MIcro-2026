;================================================================
; Mapeo de pines (Problema E - version completa con mensajes USART):
;   PD0 - RXD (USART, manejado por hardware) - comandos del control remoto
;   PD1 - TXD (USART, manejado por hardware) - mensajes de estado
;   PD4 - LED motor abriendo
;   PD5 - LED motor cerrando
;   PD6 - Alarma
;   PC0 - Sensor de obstaculo (pulsador, pull-up) - PCINT8
;   PC1 - Sensor puerta cerrada (pulsador, pull-up)
;   PC2 - Sensor puerta abierta (pulsador, pull-up)
;================================================================
.equ ST_CERRADA  = 0
.equ ST_ABRIENDO = 1
.equ ST_ABIERTA  = 2
.equ ST_CERRANDO = 3
.equ ST_DETENIDA = 4

.include "m328Pdef.inc"

.org 0x0000
    rjmp RESET
.org 0x0008
    rjmp OBSTACULO_ISR              ; vector PCINT1 (cubre PC0:PC6)

.org 0x001A
;================================================================
; Programa principal
;================================================================
RESET:
    ; --- Stack Pointer ---
    ldi r16, low(RAMEND)
    out SPL, r16
    ldi r16, high(RAMEND)
    out SPH, r16
    clr r1                          ; registro cero para direccionar las LUT

    ; --- PD4:PD6 como salida ---
    ldi r16, 0b01110000
    out DDRD, r16
    clr r16
    out PORTD, r16

    ; --- PC0:PC2 como entrada con pull-up ---
    ldi r16, 0b00000000
    out DDRC, r16
    ldi r16, 0b00000111
    out PORTC, r16

    ; --- Configurar USART: 9600 baudios, 8N1, TX y RX ---
    rcall USART_INIT

    ; --- Habilitar interrupcion por cambio de pin en PC0 (PCINT8) ---
    ldi r16, (1<<PCIF1)
    out PCIFR, r16                  ; limpiar flag pendiente antes de habilitar
    ldi r16, (1<<PCIE1)
    sts PCICR, r16
    ldi r16, (1<<PCINT8)
    sts PCMSK1, r16
    sei                              ; habilitar interrupciones globales

    ; --- Estado inicial: puerta cerrada ---
    ldi r17, ST_CERRADA
    rcall ACTUALIZAR_SALIDAS

MAIN_LOOP:
    ; --- Verificar si llego un comando por USART ---
    lds r16, UCSR0A
    sbrs r16, RXC0
    rjmp CHECK_SENSORES
    lds r18, UDR0

    ; --- Comando 'A': CERRADA o DETENIDA -> ABRIENDO ---
    cpi r18, 'A'
    brne CHECK_C
    cpi r17, ST_CERRADA
    breq DO_ABRIR
    cpi r17, ST_DETENIDA
    breq DO_ABRIR
    rjmp MAIN_LOOP
DO_ABRIR:
    ldi r17, ST_ABRIENDO
    rcall ACTUALIZAR_SALIDAS
    rjmp MAIN_LOOP

CHECK_C:
    ; --- Comando 'C': ABIERTA o DETENIDA -> CERRANDO ---
    cpi r18, 'C'
    brne MAIN_LOOP
    cpi r17, ST_ABIERTA
    breq DO_CERRAR
    cpi r17, ST_DETENIDA
    breq DO_CERRAR
    rjmp MAIN_LOOP
DO_CERRAR:
    ldi r17, ST_CERRANDO
    rcall ACTUALIZAR_SALIDAS
    rjmp MAIN_LOOP

CHECK_SENSORES:
    ; --- ABRIENDO + sensor puerta abierta -> ABIERTA ---
    cpi r17, ST_ABRIENDO
    brne CHECK_SENSOR_CERRADA
    sbic PINC, 2                    ; activo en bajo (pull-up)
    rjmp MAIN_LOOP
    ldi r17, ST_ABIERTA
    rcall ACTUALIZAR_SALIDAS
    rjmp MAIN_LOOP

CHECK_SENSOR_CERRADA:
    ; --- CERRANDO + sensor puerta cerrada -> CERRADA ---
    cpi r17, ST_CERRANDO
    brne MAIN_LOOP
    sbic PINC, 1
    rjmp MAIN_LOOP
    ldi r17, ST_CERRADA
    rcall ACTUALIZAR_SALIDAS
    rjmp MAIN_LOOP

;================================================================
; ACTUALIZAR_SALIDAS: pone LEDs/alarma y transmite el mensaje
; correspondiente al estado en r17
;================================================================
ACTUALIZAR_SALIDAS:
    ; --- LEDs/alarma ---
    ldi ZL, low(LUT_SALIDAS*2)
    ldi ZH, high(LUT_SALIDAS*2)
    add ZL, r17
    adc ZH, r1
    lpm r16, Z
    out PORTD, r16

    ; --- Buscar el puntero al mensaje de este estado ---
    ldi ZL, low(MSG_TABLE*2)
    ldi ZH, high(MSG_TABLE*2)
    mov r19, r17
    lsl r19                          ; cada entrada de la tabla ocupa 2 bytes
    add ZL, r19
    adc ZH, r1
    lpm r20, Z+
    lpm r21, Z
    mov ZL, r20
    mov ZH, r21
    rcall TX_STRING
    ret

;================================================================
; USART_INIT: 9600 baudios, 8 bits, sin paridad, 1 stop, TX+RX
;================================================================
USART_INIT:
    ldi r16, high(103)
    sts UBRR0H, r16
    ldi r16, low(103)
    sts UBRR0L, r16
    ldi r16, (1<<RXEN0)|(1<<TXEN0)
    sts UCSR0B, r16
    ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, r16
    ret

;================================================================
; TX_STRING: transmite la cadena apuntada por Z, terminada en 0
;================================================================
TX_STRING:
    lpm r16, Z+
    cpi r16, 0
    breq TX_STRING_FIN
TX_STRING_WAIT:
    lds r18, UCSR0A
    sbrs r18, UDRE0
    rjmp TX_STRING_WAIT
    sts UDR0, r16
    rjmp TX_STRING
TX_STRING_FIN:
    ret

;================================================================
; OBSTACULO_ISR: si esta ABRIENDO/CERRANDO, pasa a DETENIDA
;================================================================
OBSTACULO_ISR:
    push r16
    in r16, SREG
    push r16
    push r18
    push r19
    push r20
    push r21
    push ZL
    push ZH

    sbic PINC, 0                    ; si esta en alto (no presionado), salir
    rjmp OBSTACULO_FIN

    cpi r17, ST_ABRIENDO
    breq OBSTACULO_DETENER
    cpi r17, ST_CERRANDO
    breq OBSTACULO_DETENER
    rjmp OBSTACULO_FIN

OBSTACULO_DETENER:
    ldi r17, ST_DETENIDA
    rcall ACTUALIZAR_SALIDAS

OBSTACULO_FIN:
    pop ZH
    pop ZL
    pop r21
    pop r20
    pop r19
    pop r18
    pop r16
    out SREG, r16
    pop r16
    reti

;================================================================
; LUT: patron de PD4:PD6 (LEDs + alarma) para cada estado
;================================================================
LUT_SALIDAS:
    .db 0b00000000, 0b01010000, 0b00000000, 0b01100000, 0b00000000, 0b00000000
    ; CERRADA,     ABRIENDO,    ABIERTA,    CERRANDO,    DETENIDA,   (relleno)

;================================================================
; Tabla de punteros a los mensajes de cada estado
;================================================================
MSG_TABLE:
    .dw MSG_CERRADA*2, MSG_ABRIENDO*2, MSG_ABIERTA*2, MSG_CERRANDO*2, MSG_DETENIDA*2

MSG_CERRADA:
    .db "Puerta cerrada.", 13, 10, 0
MSG_ABRIENDO:
    .db "Puerta abriendo.", 13, 10, 0, 0
MSG_ABIERTA:
    .db "Puerta abierta.", 13, 10, 0
MSG_CERRANDO:
    .db "Puerta cerrando.", 13, 10, 0, 0
MSG_DETENIDA:
    .db "Obstaculo detectado.", 13, 10, "Movimiento detenido por seguridad.", 13, 10, 0, 0