; =====================================================================
; Matriz de LEDS
; =====================================================================

.include "m328pdef.inc"

.def temp     = r16
.def temp2    = r17
.def rowout   = r18
.def colidx   = r19
.def fila_idx = r20

.equ SCROLL_LEN = 106

.dseg
.org 0x0100
modo:        .byte 1
scroll_pos:  .byte 1
velocidad:   .byte 1
contador_v:  .byte 1

.cseg
.org 0x0000
    rjmp INICIO

.org 0x0020
    rjmp ISR_TIMER0

.org 0x0024
    rjmp ISR_USART_RX

INICIO:
    ldi    temp, HIGH(RAMEND)
    out    SPH, temp
    ldi    temp, LOW(RAMEND)
    out    SPL, temp

    ldi    temp, 0x3F
    out    DDRB, temp

    in     temp, DDRD
    ori    temp, 0xFC
    out    DDRD, temp

    ldi    temp, 0x0F
    out    DDRC, temp

    in     temp, PORTB
    andi   temp, 0xC0
    out    PORTB, temp

    in     temp, PORTC
    andi   temp, 0xFC
    ori    temp, 0x0C
    out    PORTC, temp

    in     temp, PORTD
    ori    temp, 0xFC
    out    PORTD, temp

    clr    temp
    sts    modo, temp
    sts    scroll_pos, temp
    sts    contador_v, temp
    clr    fila_idx

    ldi    temp, 15
    sts    velocidad, temp

    ; 5. UART (9600 baudios @ 16 MHz)
    ldi    temp, HIGH(103)
    sts    UBRR0H, temp
    ldi    temp, LOW(103)
    sts    UBRR0L, temp

    ldi    temp, (1<<RXEN0)|(1<<TXEN0)|(1<<RXCIE0)
    sts    UCSR0B, temp

    ldi    temp, (1<<UCSZ01)|(1<<UCSZ00)
    sts    UCSR0C, temp

    ; 6. Imprimir Menú Completo
    rcall IMPRIMIR_MENU_COMPLETO

BUCLE_PRINCIPAL:
    rjmp BUCLE_PRINCIPAL

ISR_TIMER0:
    reti

ISR_USART_RX:
    reti

UART_TX_CHAR:
    lds    temp2, UCSR0A
    sbrs   temp2, UDRE0
    rjmp   UART_TX_CHAR
    sts    UDR0, temp
    ret

IMPRIMIR_MENU_COMPLETO:
    ldi    ZL, LOW(TEXTO_MENU*2)
    ldi    ZH, HIGH(TEXTO_MENU*2)

LOOP_MENU_TEXTO:
    lpm    temp, Z+
    tst    temp
    breq   FIN_MENU_TEXTO
    rcall  UART_TX_CHAR
    rjmp   LOOP_MENU_TEXTO

FIN_MENU_TEXTO:
    ret

.align 2
TEXTO_MENU:
.db "=== MATRIZ LED 8x8 ===", 13, 10, "1. Mensaje en pantalla", 13, 10, "2. Imagen Carita", 13, 10, "3. Imagen Corazon", 13, 10, "+ : Aumentar Velocidad", 13, 10, "- : Disminuir Velocidad", 13, 10, "Opcion: ", 0, 0