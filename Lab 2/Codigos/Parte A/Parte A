; =====================================================================
; Matriz de LEDS
; =====================================================================

.include "m328pdef.inc"

.def temp     = r16
.def temp2    = r17
.def rowout   = r18
.def colidx   = r19
.def fila_idx = r20

.equ SCROLL_LEN = 106

.dseg
.org 0x0100
modo:        .byte 1
scroll_pos:  .byte 1
velocidad:   .byte 1
contador_v:  .byte 1

.cseg
.org 0x0000
    rjmp INICIO

.org 0x0020
    rjmp ISR_TIMER0

.org 0x0024
    rjmp ISR_USART_RX

INICIO:
    ldi    temp, HIGH(RAMEND)
    out    SPH, temp
    ldi    temp, LOW(RAMEND)
    out    SPL, temp

    ldi    temp, 0x3F
    out    DDRB, temp

    in     temp, DDRD
    ori    temp, 0xFC
    out    DDRD, temp

    ldi    temp, 0x0F
    out    DDRC, temp

    in     temp, PORTB
    andi   temp, 0xC0
    out    PORTB, temp

    in     temp, PORTC
    andi   temp, 0xFC
    ori    temp, 0x0C
    out    PORTC, temp

    in     temp, PORTD
    ori    temp, 0xFC
    out    PORTD, temp

    clr    temp
    sts    modo, temp
    sts    scroll_pos, temp
    sts    contador_v, temp
    clr    fila_idx

    ldi    temp, 15
    sts    velocidad, temp

    ldi    temp, HIGH(103)
    sts    UBRR0H, temp
    ldi    temp, LOW(103)
    sts    UBRR0L, temp

    ldi    temp, (1<<RXEN0)|(1<<TXEN0)|(1<<RXCIE0)
    sts    UCSR0B, temp

    ldi    temp, (1<<UCSZ01)|(1<<UCSZ00)
    sts    UCSR0C, temp

    rcall IMPRIMIR_MENU_COMPLETO

    ldi    temp, (1<<CS02)
    out    TCCR0B, temp

    ldi    temp, (1<<TOIE0)
    sts    TIMSK0, temp

    sei

BUCLE_PRINCIPAL:
    rjmp BUCLE_PRINCIPAL

ISR_TIMER0:
    push   temp
    in     temp, SREG
    push   temp
    push   temp2
    push   rowout
    push   ZL
    push   ZH

    in     temp, PORTB
    andi   temp, 0xC0
    out    PORTB, temp

    in     temp, PORTC
    andi   temp, 0xFC
    out    PORTC, temp

    in     temp, PORTD
    ori    temp, 0xFC
    out    PORTD, temp

    in     temp, PORTC
    ori    temp, 0x0C
    out    PORTC, temp

    lds    temp, modo
    cpi    temp, 0
    breq   TMR_MODO_SCROLL
    cpi    temp, 1
    breq   TMR_MODO_IMG1
    rjmp   TMR_MODO_IMG2

TMR_MODO_SCROLL:
    lds    temp, scroll_pos
    add    temp, fila_idx
    cpi    temp, SCROLL_LEN
    brlo   TMR_SCROLL_OK
    subi   temp, SCROLL_LEN
TMR_SCROLL_OK:
    ldi    ZL, LOW(SCROLL_TABLE*2)
    ldi    ZH, HIGH(SCROLL_TABLE*2)
    clr    temp2
    add    ZL, temp
    adc    ZH, temp2
    lpm    rowout, Z
    rjmp   TMR_DATO_LISTO

TMR_MODO_IMG1:
    ldi    ZL, LOW(IMG_SMILE*2)
    ldi    ZH, HIGH(IMG_SMILE*2)
    rjmp   TMR_IMG_COMUN

TMR_MODO_IMG2:
    ldi    ZL, LOW(IMG_HEART*2)
    ldi    ZH, HIGH(IMG_HEART*2)
TMR_IMG_COMUN:
    clr    temp2
    add    ZL, fila_idx
    adc    ZH, temp2
    lpm    rowout, Z

TMR_DATO_LISTO:
    mov    temp, rowout
    com    temp

    mov    temp2, temp
    lsl    temp2
    lsl    temp2
    andi   temp2, 0xFC
    in     rowout, PORTD
    andi   rowout, 0x03
    or     rowout, temp2
    out    PORTD, rowout

    mov    temp2, temp
    lsr    temp2
    lsr    temp2
    lsr    temp2
    lsr    temp2
    andi   temp2, 0x0C
    in     rowout, PORTC
    andi   rowout, 0xF3
    or     rowout, temp2
    out    PORTC, temp2

    cpi    fila_idx, 0
    breq   F0_ON
    cpi    fila_idx, 1
    breq   F1_ON
    cpi    fila_idx, 2
    breq   F2_ON
    cpi    fila_idx, 3
    breq   F3_ON
    cpi    fila_idx, 4
    breq   F4_ON
    cpi    fila_idx, 5
    breq   F5_ON
    cpi    fila_idx, 6
    breq   F6_ON
    cpi    fila_idx, 7
    breq   F7_ON
    rjmp   SIG_FILA

F0_ON: sbi PORTB, 0 \ rjmp SIG_FILA
F1_ON: sbi PORTB, 1 \ rjmp SIG_FILA
F2_ON: sbi PORTB, 2 \ rjmp SIG_FILA
F3_ON: sbi PORTB, 3 \ rjmp SIG_FILA
F4_ON: sbi PORTB, 4 \ rjmp SIG_FILA
F5_ON: sbi PORTB, 5 \ rjmp SIG_FILA
F6_ON: sbi PORTC, 0 \ rjmp SIG_FILA
F7_ON: sbi PORTC, 1 \ rjmp SIG_FILA

SIG_FILA:
    inc    fila_idx
    cpi    fila_idx, 8
    brlo   TMR_FIN_ISR
    clr    fila_idx

    lds    temp, contador_v
    inc    temp
    lds    temp2, velocidad
    cp     temp, temp2
    brlo   TMR_GUARDAR_CONTADOR

    clr    temp
    lds    temp2, modo
    cpi    temp2, 0
    brne   TMR_GUARDAR_CONTADOR

    lds    temp2, scroll_pos
    inc    temp2
    cpi    temp2, SCROLL_LEN
    brlo   TMR_GUARDAR_SCROLLPOS
    clr    temp2

TMR_GUARDAR_SCROLLPOS:
    sts    scroll_pos, temp2
TMR_GUARDAR_CONTADOR:
    sts    contador_v, temp

TMR_FIN_ISR:
    pop    ZH
    pop    ZL
    pop    rowout
    pop    temp2
    pop    temp
    out    SREG, temp
    pop    temp
    reti

ISR_USART_RX:
    push   temp
    in     temp, SREG
    push   temp
    push   temp2

    lds    temp, UDR0

    cpi    temp, '1'
    brne   RX_CHK2
    clr    temp2
    sts    modo, temp2
    rjmp   RX_FIN

RX_CHK2:
    cpi    temp, '2'
    brne   RX_CHK3
    ldi    temp2, 1
    sts    modo, temp2
    rjmp   RX_FIN

RX_CHK3:
    cpi    temp, '3'
    brne   RX_CHKMAS
    ldi    temp2, 2
    sts    modo, temp2
    rjmp   RX_FIN

RX_CHKMAS:
    cpi    temp, '+'
    brne   RX_CHKMENOS
    lds    temp2, velocidad
    cpi    temp2, 2
    brlo   RX_FIN
    dec    temp2
    sts    velocidad, temp2
    rjmp   RX_FIN

RX_CHKMENOS:
    cpi    temp, '-'
    brne   RX_FIN
    lds    temp2, velocidad
    cpi    temp2, 60
    brsh   RX_FIN
    inc    temp2
    sts    velocidad, temp2

RX_FIN:
    pop    temp2
    pop    temp
    out    SREG, temp
    pop    temp
    reti

UART_TX_CHAR:
    lds    temp2, UCSR0A
    sbrs   temp2, UDRE0
    rjmp   UART_TX_CHAR
    sts    UDR0, temp
    ret

IMPRIMIR_MENU_COMPLETO:
    ldi    ZL, LOW(TEXTO_MENU*2)
    ldi    ZH, HIGH(TEXTO_MENU*2)
LOOP_MENU_TEXTO:
    lpm    temp, Z+
    tst    temp
    breq   FIN_MENU_TEXTO
    rcall  UART_TX_CHAR
    rjmp   LOOP_MENU_TEXTO
FIN_MENU_TEXTO:
    ret

.align 2
TEXTO_MENU:
.db "=== MATRIZ LED 8x8 ===", 13, 10, "1. Mensaje en pantalla", 13, 10, "2. Imagen Carita", 13, 10, "3. Imagen Corazon", 13, 10, "+ : Aumentar Velocidad", 13, 10, "- : Disminuir Velocidad", 13, 10, "Opcion: ", 0, 0

.align 2
SCROLL_TABLE:
.db 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00
.db 0x7F,0x02,0x0C,0x02,0x7F,0x00
.db 0x00,0x41,0x7F,0x41,0x00,0x00
.db 0x3E,0x41,0x41,0x41,0x22,0x00
.db 0x7F,0x09,0x19,0x29,0x46,0x00
.db 0x3E,0x41,0x41,0x41,0x3E,0x00
.db 0x46,0x49,0x49,0x49,0x31,0x00
.db 0x00,0x00,0x00,0x7F,0x40,0x40
.db 0x40,0x40,0x00,0x3E,0x41,0x41
.db 0x41,0x3E,0x00,0x00,0x00,0x00
.db 0x7F,0x02,0x0C,0x02,0x7F,0x00
.db 0x7F,0x49,0x49,0x49,0x41,0x00
.db 0x20,0x40,0x41,0x41,0x3F,0x00
.db 0x3E,0x41,0x41,0x41,0x3E,0x00
.db 0x7F,0x09,0x19,0x29,0x46,0x00
.db 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00

.align 2
IMG_SMILE:
.db 0x3C,0x42,0xA5,0x81,0xC3,0x3C,0x42,0x3C

.align 2
IMG_HEART:
.db 0x66,0xFF,0xFF,0xFF,0x7E,0x3C,0x18,0x00