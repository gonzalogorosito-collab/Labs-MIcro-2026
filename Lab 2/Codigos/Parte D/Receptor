;================================================================
; Mapeo de pines (receptor, paso 1 - solo verificacion de RX):
;   PD0 - RXD (USART, manejado por hardware)
;   PB0 - LED de prueba bit0
;   PB1 - LED de prueba bit1
;   PB2 - LED de prueba bit2
;================================================================
.include "m328Pdef.inc"
.org 0x0000
    rjmp RESET
;================================================================
; Programa principal
;================================================================
RESET:
    ; --- Stack Pointer ---
    ldi r16, low(RAMEND)
    out SPL, r16
    ldi r16, high(RAMEND)
    out SPH, r16
    ; --- LEDs de prueba en PB0:PB2 como salida ---
    ldi r16, 0b00000111
    out DDRB, r16
    clr r16
    out PORTB, r16
    ; --- Configurar USART: 9600 baudios, 8N1, solo recepcion ---
    rcall USART_INIT
MAIN_LOOP:
    ; --- Esperar byte recibido ---
    lds r16, UCSR0A
    sbrs r16, RXC0
    rjmp MAIN_LOOP
    lds r17, UDR0
    andi r17, 0b00000111        ; nos aseguramos de quedarnos solo con 0-7
    out PORTB, r17              ; LEDs de prueba muestran el valor recibido
    rjmp MAIN_LOOP
;================================================================
; USART_INIT: 9600 baudios, 8 bits, 16MHz
;================================================================
USART_INIT:
    ldi r16, high(103)
    sts UBRR0H, r16
    ldi r16, low(103)
    sts UBRR0L, r16
    ldi r16, (1<<RXEN0)
    sts UCSR0B, r16
    ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, r16
    ret