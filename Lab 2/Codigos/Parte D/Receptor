;================================================================
; Mapeo de pines (receptor):
;   PD0 - RXD (USART, manejado por hardware)
;   PD2:PD7 - LEDs de salida 0 a 5
;   PB0:PB1 - LEDs de salida 6 y 7
;================================================================
.include "m328Pdef.inc"
.org 0x0000
    rjmp RESET
;================================================================
; Programa principal
;================================================================
RESET:
    ; --- Stack Pointer ---
    ldi r16, low(RAMEND)
    out SPL, r16
    ldi r16, high(RAMEND)
    out SPH, r16
    ; --- Registro cero, para propagar acarreo al direccionar la LUT ---
    clr r1
    ; --- Salidas 0:5 en PD2:PD7 ---
    ldi r16, 0b11111100
    out DDRD, r16
    clr r16
    out PORTD, r16
    ; --- Salidas 6:7 en PB0:PB1 ---
    ldi r16, 0b00000011
    out DDRB, r16
    clr r16
    out PORTB, r16
    ; --- Configurar USART: 9600 baudios, 8N1, solo recepcion ---
    rcall USART_INIT
MAIN_LOOP:
    ; --- Esperar byte recibido ---
    lds r16, UCSR0A
    sbrs r16, RXC0
    rjmp MAIN_LOOP
    lds r17, UDR0
    andi r17, 0b00000111        ; nos aseguramos de quedarnos solo con 0-7

    ; --- Buscar patron de PORTD en la LUT ---
    ldi ZL, low(LUT_PORTD*2)
    ldi ZH, high(LUT_PORTD*2)
    add ZL, r17
    adc ZH, r1
    lpm r18, Z

    ; --- Buscar patron de PORTB en la LUT ---
    ldi ZL, low(LUT_PORTB*2)
    ldi ZH, high(LUT_PORTB*2)
    add ZL, r17
    adc ZH, r1
    lpm r19, Z

    out PORTD, r18
    out PORTB, r19
    rjmp MAIN_LOOP
;================================================================
; USART_INIT: 9600 baudios, 8 bits, 16MHz
;================================================================
USART_INIT:
    ldi r16, high(103)
    sts UBRR0H, r16
    ldi r16, low(103)
    sts UBRR0L, r16
    ldi r16, (1<<RXEN0)
    sts UCSR0B, r16
    ldi r16, (1<<UCSZ01)|(1<<UCSZ00)
    sts UCSR0C, r16
    ret
;================================================================
; LUT: patron de salida para cada valor recibido (0 a 7)
;================================================================
LUT_PORTD:
    .db 0b00000100, 0b00001000, 0b00010000, 0b00100000, 0b01000000, 0b10000000, 0b00000000, 0b00000000
LUT_PORTB:
    .db 0b00000000, 0b00000000, 0b00000000, 0b00000000, 0b00000000, 0b00000000, 0b00000001, 0b00000010